+// pisces: hand the buffer handles straight through to the HAL instead of cloning
+// and registering them.  The NVIDIA composer crashed inside NvGrUnregisterBuffer
+// (destroyLayer) and NvGrAddFence (presentDisplay) when it was given our clones.
+// Toggle with persist.pisces.mapper_passthrough for A/B testing.
+// pisces: force a full (re)registration of cloned buffer handles, see below.
+// pisces: the NVIDIA HWC unregisters the buffers it releases itself, so calling
+// unregisterBuffer() from here as well drives the refcount negative and the
+// second teardown dereferences an already munmapped private mapping.
+// pisces: the NVIDIA HWC registers and unregisters the buffers it composes
+// itself, and the refcount (plus the mmap pointer) lives inside the buffer
+// handle.  Registering from the mapper as well makes the two owners fight over
+// that shared state: the count goes negative, the teardown runs twice and the
+// composer dies with "pthread_mutex_destroy called on a destroyed mutex" (or
+// dereferences an already unmapped private mapping).  In pure clone mode the
+// mapper only hands the HAL a private copy of the handle.
+static inline bool piscesMapperPureClone() {
+    char value[PROPERTY_VALUE_MAX] = {0};
+    property_get("persist.pisces.mapper_pure_clone", value, "1");
+    return value[0] == '1';
+}
+
+static inline bool piscesGrallocNoUnregister() {
+    char value[PROPERTY_VALUE_MAX] = {0};
+    property_get("persist.pisces.gralloc_nounregister", value, "0");
+    return value[0] == '1';
+}
+
+// pisces: the NVIDIA gralloc keeps its per-buffer bookkeeping inside the
+// handle (owner pid at data[2], refcount at byte offset 152, private mapping at
+// byte offset 128).  Logging the refcount on import/free shows whether the HWC
+// also registers/unregisters the same handle.
+static inline int piscesRefcount(native_handle_t* handle) {
+    const int index = (152 - 12) / 4;
+    if (handle->numFds + handle->numInts > index && index >= handle->numFds) {
+        return handle->data[index];
+    }
+    return -1;
+}
+
+static inline int piscesOwnerPid(native_handle_t* handle) {
+    if (handle->numFds + handle->numInts > 2 && 2 >= handle->numFds) {
+        return handle->data[2];
+    }
+    return -1;
+}
+
+// pisces: the vendor composer sometimes frees the very same imported handle
+// twice.  A second NvGrUnregisterBuffer() drives the in-handle refcount negative
+// and tears the private mapping down again, which aborts with
+// "pthread_mutex_destroy called on a destroyed mutex".  Remember the pointers we
+// already released and turn the duplicate into a no-op.
+static std::mutex gPiscesFreedMutex;
+static std::unordered_set<const void*> gPiscesFreedHandles;
+
+// Returns true when this handle was already freed once.
+static inline bool piscesAlreadyFreed(const void* handle) {
+    if (!handle) {
+        return true;
+    }
+    std::lock_guard<std::mutex> lock(gPiscesFreedMutex);
+    if (gPiscesFreedHandles.size() > 8192) {
+        gPiscesFreedHandles.clear();
+    }
+    return !gPiscesFreedHandles.insert(handle).second;
+}
+
+// pisces: the vendor HWC keeps using a buffer handle after the composer has
+// released it (NvGrAddFence then reads handle->data[29], which we had already
+// torn down - the null/stale pointer crash).  Instead of releasing immediately,
+// keep the last few clones alive (with their registration and mapping) and only
+// tear the oldest one down once the quarantine is full.  The HWC's stale use is
+// within a frame or two, so a small window is enough.
+static std::mutex gPiscesQuarantineMutex;
+static std::vector<native_handle_t*> gPiscesQuarantine;
+static constexpr size_t kPiscesQuarantineSize = 2;
+
+// Returns true when the handle was queued instead of being released now.
+static inline bool piscesQuarantinePush(native_handle_t* handle, gralloc_module_t const* module) {
+    std::lock_guard<std::mutex> lock(gPiscesQuarantineMutex);
+    gPiscesQuarantine.push_back(handle);
+    if (gPiscesQuarantine.size() <= kPiscesQuarantineSize) {
+        return true;
+    }
+    native_handle_t* oldest = gPiscesQuarantine.front();
+    gPiscesQuarantine.erase(gPiscesQuarantine.begin());
+    if (module && oldest) {
+        module->unregisterBuffer(module, oldest);
+        native_handle_close(oldest);
+        native_handle_delete(oldest);
+    }
+    return true;
+}
+
+// pisces: NvGrAddFence() reads a small structure through handle->data[29],
+// which is the mapping of the buffer's first page (the vendor maps 4096 bytes,
+// not the whole buffer).  The vendor HWC keeps using a handle after the composer
+// released it, and once the vendor unregister has munmapped that page the read
+// faults.  Instead of retaining the buffer (the earlier quarantine pinned whole
+// buffers), keep a 4 KB snapshot of that page attached to the clone: the stale
+// read then hits valid memory and only costs a kilobyte per released handle.
+static std::mutex gPiscesSnapshotMutex;
+static std::vector<std::pair<native_handle_t*, void*>> gPiscesSnapshots;
+static constexpr size_t kPiscesSnapshotRing = 256;
+
+static inline bool piscesStructSnapshot() {
+    char value[PROPERTY_VALUE_MAX] = {0};
+    property_get("persist.pisces.mapper_snapshot", value, "1");
+    return value[0] == '1';
+}
+
+// pisces: NvGrUnregisterBuffer() takes the mutex that lives inside the buffer
+// page - the same page the producing app maps - and waits on the buffer fences
+// while holding it, which stalls the app's render thread in NvGrLock.  The
+// composer imports and frees a handle for every frame, so that teardown happens
+// constantly.  Cache imported handles by buffer (the nvmap inode) and reuse
+// them, so a handle is only torn down when it is evicted from the cache.
+struct PiscesCachedHandle {
+    native_handle_t* handle;
+    int refs;
+};
+static std::mutex gPiscesCacheMutex;
+static std::unordered_map<unsigned long long, PiscesCachedHandle> gPiscesHandleCache;
+static std::vector<unsigned long long> gPiscesCacheOrder;
+static constexpr size_t kPiscesCacheLimit = 8;
+
+static inline bool piscesHandleCache() {
+    char value[PROPERTY_VALUE_MAX] = {0};
+    property_get("persist.pisces.mapper_handle_cache", value, "1");
+    return value[0] == '1';
+}
+
+static inline bool piscesBufferKey(native_handle_t* handle, unsigned long long* key) {
+    // The composer hands over the same buffer_handle_t for the same buffer slot,
+    // so its address is a stable, process local key.  (The nvmap inode is shared
+    // by every buffer of the device and therefore useless as a key.)
+    if (handle == nullptr) {
+        return false;
+    }
+    *key = static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(handle));
+    return *key != 0;
+}
+
+// Returns a cached clone with an extra reference, or nullptr.
+static inline native_handle_t* piscesCacheAcquire(unsigned long long key) {
+    std::lock_guard<std::mutex> lock(gPiscesCacheMutex);
+    auto it = gPiscesHandleCache.find(key);
+    if (it == gPiscesHandleCache.end()) {
+        return nullptr;
+    }
+    it->second.refs++;
+    return it->second.handle;
+}
+
+// Adds a freshly imported clone to the cache.
+static inline void piscesCachePut(unsigned long long key, native_handle_t* handle) {
+    std::lock_guard<std::mutex> lock(gPiscesCacheMutex);
+    gPiscesHandleCache[key] = {handle, 1};
+    gPiscesCacheOrder.push_back(key);
+}
+
+// Drops one reference.  Returns true when the handle must be released now.
+static inline bool piscesCacheDrop(unsigned long long key) {
+    std::lock_guard<std::mutex> lock(gPiscesCacheMutex);
+    auto it = gPiscesHandleCache.find(key);
+    if (it == gPiscesHandleCache.end()) {
+        return true;
+    }
+    if (it->second.refs > 0) {
+        it->second.refs--;
+    }
+    return false;
+}
+
+// Pops one unreferenced entry when the cache is over its limit.
+static inline native_handle_t* piscesCacheEvict() {
+    std::lock_guard<std::mutex> lock(gPiscesCacheMutex);
+    if (gPiscesCacheOrder.size() <= kPiscesCacheLimit) {
+        return nullptr;
+    }
+    for (size_t i = 0; i < gPiscesCacheOrder.size(); i++) {
+        auto it = gPiscesHandleCache.find(gPiscesCacheOrder[i]);
+        if (it != gPiscesHandleCache.end() && it->second.refs <= 0) {
+            native_handle_t* handle = it->second.handle;
+            gPiscesHandleCache.erase(it);
+            gPiscesCacheOrder.erase(gPiscesCacheOrder.begin() + i);
+            return handle;
+        }
+    }
+    return nullptr;
+}
+
+static std::mutex gPiscesAsyncMutex;
+static std::vector<std::pair<gralloc_module_t const*, native_handle_t*>> gPiscesAsyncQueue;
+static bool gPiscesAsyncWorkerStarted = false;
+
+static inline bool piscesAsyncRelease() {
+    char value[PROPERTY_VALUE_MAX] = {0};
+    property_get("persist.pisces.mapper_async_release", value, "1");
+    return value[0] == '1';
+}
+
+static void piscesAsyncWorker() {
+    while (true) {
+        std::pair<gralloc_module_t const*, native_handle_t*> item;
+        {
+            std::lock_guard<std::mutex> lock(gPiscesAsyncMutex);
+            if (gPiscesAsyncQueue.empty()) {
+                item = {nullptr, nullptr};
+            } else {
+                item = gPiscesAsyncQueue.front();
+                gPiscesAsyncQueue.erase(gPiscesAsyncQueue.begin());
+            }
+        }
+        if (item.second == nullptr) {
+            usleep(2000);
+            continue;
+        }
+        if (item.first != nullptr) {
+            item.first->unregisterBuffer(item.first, item.second);
+        }
+    }
+}
+
+static inline void piscesQueueRelease(gralloc_module_t const* module, native_handle_t* handle) {
+    {
+        std::lock_guard<std::mutex> lock(gPiscesAsyncMutex);
+        if (!gPiscesAsyncWorkerStarted) {
+            gPiscesAsyncWorkerStarted = true;
+            std::thread(piscesAsyncWorker).detach();
+        }
+        gPiscesAsyncQueue.emplace_back(module, handle);
+    }
+}
+
+static inline int piscesPrivateOffset() {
+    return 128;   // handle->data[29]
+}
+
+// Keeps the (handle, snapshot) pair alive for a while.
+static inline void piscesRingPush(native_handle_t* handle, void* copy) {
+    if (!handle || !copy) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(gPiscesSnapshotMutex);
+    gPiscesSnapshots.emplace_back(handle, copy);
+    if (gPiscesSnapshots.size() > kPiscesSnapshotRing) {
+        auto victim = gPiscesSnapshots.front();
+        gPiscesSnapshots.erase(gPiscesSnapshots.begin());
+        free(victim.second);
+        native_handle_close(victim.first);
+        native_handle_delete(victim.first);
+    }
+}
+
+// True when the page is currently mapped in this process.  A cloned handle can
+// carry a data[29] that points into the producing process' address space, and
+// copying that would fault.
+static inline bool piscesIsMapped(const void* address) {
+    unsigned char vec = 0;
+    return mincore(const_cast<void*>(address), 4096, &vec) == 0;
+}
+
+static inline void* piscesPrivatePage(native_handle_t* handle) {
+    const int index = (piscesPrivateOffset() - 12) / 4;
+    if (handle->numFds + handle->numInts > index && index >= handle->numFds) {
+        return reinterpret_cast<void*>(static_cast<uintptr_t>(handle->data[index]));
+    }
+    return nullptr;
+}
+
+static inline void piscesSetPrivatePage(native_handle_t* handle, void* page) {
+    const int index = (piscesPrivateOffset() - 12) / 4;
+    if (handle->numFds + handle->numInts > index && index >= handle->numFds) {
+        handle->data[index] = static_cast<int>(reinterpret_cast<uintptr_t>(page));
+    }
+}
+
+static inline bool piscesQuarantineFree() {
+    char value[PROPERTY_VALUE_MAX] = {0};
+    property_get("persist.pisces.mapper_quarantine", value, "1");
+    return value[0] == '1';
+}
+
+static inline bool piscesDedupFree() {
+    char value[PROPERTY_VALUE_MAX] = {0};
+    property_get("persist.pisces.mapper_dedup_free", value, "1");
+    return value[0] == '1';
+}
+
+static inline bool piscesRefcountLog() {
+    char value[PROPERTY_VALUE_MAX] = {0};
+    property_get("persist.pisces.mapper_log", value, "0");
+    return value[0] == '1';
+}
+
+static inline bool piscesGrallocPidFix() {
+    char value[PROPERTY_VALUE_MAX] = {0};
+    property_get("persist.pisces.gralloc_pidfix", value, "0");
+    return value[0] == '1';
+}
+
+static inline bool piscesMapperPassthrough() {
+    char value[PROPERTY_VALUE_MAX] = {0};
+    property_get("persist.pisces.mapper_passthrough", value, "0");
+    return value[0] == '1';
+}
