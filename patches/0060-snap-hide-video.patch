+    /** Stops the video recorder and merges its track with the audio file. */
+    private void stopPreviewVideoRecorder(String audioPath) {
+        if (mCameraDevice != null && mRecorderHandler != null) {
+            mCameraDevice.setPreviewDataCallbackWithBuffer(mRecorderHandler, null);
+        }
+        PreviewVideoRecorder recorder = mPreviewRecorder;
+        mPreviewRecorder = null;
+        long t0 = System.currentTimeMillis();
+        long recordedDurationUs = recorder != null ? recorder.getRecordedDurationUs() : 0;
+        if (recorder != null) {
+            recorder.stop();
+        }
+        Log.i(TAG, "video encoder stopped in " + (System.currentTimeMillis() - t0) + " ms");
+        if (mRecorderThread != null) {
+            mRecorderThread.quitSafely();
+            mRecorderThread = null;
+            mRecorderHandler = null;
+        }
+        mRecorderBuffer = null;
+        String videoPath = mVideoTempPath;
+        mVideoTempPath = null;
+        if (videoPath == null || audioPath == null) {
+            Log.w(TAG, "nothing to merge (video=" + videoPath + ", audio=" + audioPath + ")");
+            return;
+        }
+        String mergedPath = new File(mActivity.getCacheDir(), "recording.merged.mp4")
+                .getAbsolutePath();
+        long t1 = System.currentTimeMillis();
+        // In the no-audio mode there is no recorder file: give the video a
+        // silent track, otherwise the gallery's player only shows a black frame.
+        String audioSource = audioPath;
+        if (!new File(audioSource).exists()) {
+            long durationUs = recordedDurationUs;
+            File silence = new File(mActivity.getCacheDir(), "silence.m4a");
+            if (durationUs > 0
+                    && PreviewVideoRecorder.makeSilentAudio(silence.getAbsolutePath(), durationUs)) {
+                audioSource = silence.getAbsolutePath();
+                Log.i(TAG, "added a " + durationUs / 1000 + " ms silent track");
+            }
+        }
+        boolean merged = PreviewVideoRecorder.remux(videoPath, audioSource, mergedPath,
+                mMediaRecorderRotationHint);
+        Log.i(TAG, "remux took " + (System.currentTimeMillis() - t1) + " ms (ok=" + merged + ")");
+        if (merged) {
+            long t2 = System.currentTimeMillis();
+            publishRecording(mergedPath, audioPath);
+            Log.i(TAG, "publish took " + (System.currentTimeMillis() - t2) + " ms");
+            new File(videoPath).delete();
+            if (mAudioPath != null) {
+                new File(mAudioPath).delete();   // the recorder's temp audio
+                mAudioPath = null;
+            }
+            new File(mergedPath).delete();
+        } else {
+            // No usable audio: publish the video only file rather than losing
+            // the whole recording.
+            Log.w(TAG, "could not merge the audio, publishing the video track only");
+            publishRecording(videoPath, audioPath);
+            new File(videoPath).delete();
+            if (mAudioPath != null) {
+                new File(mAudioPath).delete();
+                mAudioPath = null;
+            }
+        }
+    }
