+    /** Encodes the camera preview frames into a video-only file. */
+    private void startPreviewVideoRecorder() {
+        if (mPreviewRecorder != null || mCameraDevice == null) {
+            return;
+        }
+        // Keep the recorded (== preview) size small: the software H.264 encoder
+        // cannot keep up with 1024x576/720p, which made the preview stutter and
+        // the encoded track drift away from the audio.
+        Camera.Size current = mParameters.getPreviewSize();
+        if (current != null && current.width * current.height > 640 * 480) {
+            Camera.Size best = null;
+            for (Camera.Size size : mParameters.getSupportedPreviewSizes()) {
+                if (size.width * size.height <= 640 * 480
+                        && (best == null || size.width * size.height
+                                > best.width * best.height)) {
+                    best = size;
+                }
+            }
+            if (best != null) {
+                // Do not push new parameters while the preview is running: on
+                // this HAL that left the preview callback with black frames.
+                // getDesiredPreviewSize() asks for a 480p preview up front
+                // instead.
+                Log.i(TAG, "recording will use the preview size directly");
+            }
+        }
+        Camera.Size previewSize = mParameters.getPreviewSize();
+        int width = previewSize != null ? previewSize.width : mProfile.videoFrameWidth;
+        int height = previewSize != null ? previewSize.height : mProfile.videoFrameHeight;
+        mVideoTempPath = new File(mActivity.getCacheDir(), "recording.mp4.video").getAbsolutePath();
+        mPreviewRecorder = new PreviewVideoRecorder();
+        mPreviewRecorder.setAudioEnabled(false);
+        try {
+            int bitRate = Math.min(mProfile.videoBitRate, width * height * 4);
+            mPreviewRecorder.start(width, height, mProfile.videoFrameRate,
+                    bitRate, mVideoTempPath, mMediaRecorderRotationHint);
+        } catch (Exception e) {
+            Log.e(TAG, "cannot start the preview recorder", e);
+            mPreviewRecorder = null;
+            mVideoTempPath = null;
+            return;
+        }
+        mRecorderThread = new HandlerThread("VideoRecorder");
+        mRecorderThread.start();
+        mRecorderHandler = new Handler(mRecorderThread.getLooper());
+        mRecorderBuffer = new byte[width * height * 3 / 2];
+        mCameraDevice.addCallbackBuffer(mRecorderBuffer);
+        mCameraDevice.setPreviewDataCallbackWithBuffer(mRecorderHandler,
+                new CameraManager.CameraPreviewDataCallback() {
+                    @Override
+                    public void onPreviewFrame(byte[] data, CameraManager.CameraProxy camera) {
+                        PreviewVideoRecorder recorder = mPreviewRecorder;
+                        if (recorder != null) {
+                            recorder.offerFrame(data);
+                        }
+                        if (mCameraDevice != null) {
+                            mCameraDevice.addCallbackBuffer(data);
+                        }
+                    }
+                });
+        Log.i(TAG, "preview video recorder started at " + width + "x" + height);
+    }
