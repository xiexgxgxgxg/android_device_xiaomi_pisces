+Error Allocator::allocateLocally(const IMapper::BufferDescriptorInfo& info,
+        uint32_t count, uint32_t* outStride, buffer_handle_t* outBufferHandles) const {
+    // Release everything allocated so far, both the mapper clones and the
+    // gralloc memory behind them.
+    auto rollback = [&](uint32_t done) {
+        for (uint32_t j = 0; j < done; j++) {
+            if (outBufferHandles[j] != nullptr) {
+                mMapper.freeBuffer(outBufferHandles[j]);
+                outBufferHandles[j] = nullptr;
+            }
+        }
+    };
+
+    alloc_device_t* device = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(gLocalGrallocMutex);
+        device = getLocalGrallocDeviceLocked();
+    }
+    if (device == nullptr) {
+        return Error::NO_RESOURCES;
+    }
+
+    uint32_t stride = 0;
+    for (uint32_t i = 0; i < count; i++) {
+        buffer_handle_t handle = nullptr;
+        int s = 0;
+        int res = device->alloc(device, static_cast<int>(info.width),
+                static_cast<int>(info.height),
+                static_cast<int>(info.format), static_cast<int>(info.usage),
+                &handle, &s);
+        if (res != 0 || handle == nullptr) {
+            ALOGE("pisces: local gralloc alloc failed: %d", res);
+            rollback(i);
+            return Error::NO_RESOURCES;
+        }
+        stride = static_cast<uint32_t>(s);
+        Error error = mMapper.importBuffer(handle, &outBufferHandles[i]);
+        if (error != Error::NONE) {
+            ALOGE("pisces: local import failed: %d", error);
+            device->free(device, handle);
+            outBufferHandles[i] = nullptr;
+            rollback(i);
+            return error;
+        }
+        // pisces: importBuffer clones the handle; remember the original so the
+        // memory can be released when the clone is freed.
+        {
+            std::lock_guard<std::mutex> lock(gLocalGrallocMutex);
+            gLocalGrallocOrigins[outBufferHandles[i]] = handle;
+        }
+    }
+    *outStride = stride;
+    return Error::NONE;
+}
