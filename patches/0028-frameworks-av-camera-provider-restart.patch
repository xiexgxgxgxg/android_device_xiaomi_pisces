+ * stay claimed) when that client disconnects.  The very next real open - the
+ * camera app - then fails with 0xd / 0x30012.  The parameter blob is static,
+ * so keep a copy in /data/misc/cameraserver and serve it from there on later
+ * boots, which means the camera is never touched before the app opens it.
+ */
+static const char kShimParamsCache[] =
+        "/data/misc/cameraserver/pisces_shim_params.txt";
+
+static bool readShimParamsCache(String8 *out) {
+    FILE *f = fopen(kShimParamsCache, "re");
+    if (f == NULL) return false;
+    char buf[4096];
+    size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+    fclose(f);
+    if (n == 0) return false;
+    buf[n] = '\0';
+    out->setTo(buf, n);
+    return true;
+}
+
+static void writeShimParamsCache(const String8 &params) {
+    if (params.size() == 0 || params.size() >= 4095) return;
+    FILE *f = fopen(kShimParamsCache, "we");
+    if (f == NULL) return;
+    fwrite(params.string(), 1, params.size(), f);
+    fclose(f);
+}
 
