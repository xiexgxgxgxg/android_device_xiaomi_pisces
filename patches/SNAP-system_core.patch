+// pisces: without sdcardfs the storage tree keeps the permissions the creating
+// app gave it (Snap creates DCIM/Camera with 0700), so the gallery cannot even
+// open the photos - they show up as gray rectangles.  Walk the tree once per
+// boot and make directories traversable/writable and files readable by every
+// app.  This gives up the per-app isolation sdcardfs would provide, but it is
+// the only way to make shared storage work on this kernel.
+static void relax_tree(const std::string& path, int depth, int* changed) {
+    DIR* dir = opendir(path.c_str());
+    if (dir == nullptr) {
+        return;
+    }
+    struct dirent* entry;
+    while ((entry = readdir(dir)) != nullptr) {
+        if (entry->d_name[0] == '.') {
+            continue;  // ".", ".." and hidden files are left alone
+        }
+        const std::string child = path + "/" + entry->d_name;
+        struct stat st;
+        if (lstat(child.c_str(), &st) != 0 || S_ISLNK(st.st_mode)) {
+            continue;
+        }
+        if (S_ISDIR(st.st_mode)) {
+            if (chmod(child.c_str(), 0777) != 0) {
+                PLOG(WARNING) << "chmod failed for " << child;
+            } else if ((st.st_mode & 0777) != 0777) {
+                *changed += 1;
+            }
+            if (depth < 8) {
+                relax_tree(child, depth + 1, changed);
+            }
+        } else if (S_ISREG(st.st_mode)) {
+            if ((st.st_mode & 0444) != 0444) {
+                if (chmod(child.c_str(), 0666) != 0) {
+                    PLOG(WARNING) << "chmod failed for " << child;
+                } else {
+                    *changed += 1;
+                }
+            }
+        }
+    }
+    closedir(dir);
+}
