+    if (chmod(root.c_str(), 0777) != 0) {
+        PLOG(WARNING) << "chmod failed for " << root;
+    }
+    int changed = 0;
+    relax_tree(root, 0, &changed);
+    LOG(INFO) << "pisces: storage tree relaxed, " << changed << " entr(y/ies) fixed";
+}
