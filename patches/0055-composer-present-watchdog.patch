 // TODO own a CommandReaderBase rather than subclassing
+// pisces: the vendor HWC's set() sometimes never returns, which leaves
+// SurfaceFlinger blocked in presentDisplay() and every window operation queued
+// behind it until the system watchdog restarts the whole framework.  Exiting the
+// composer process instead lets init respawn it and SurfaceFlinger recovers by
+// itself (verified: killing the composer only blanks the screen for a moment).
+static std::atomic<long long> gPiscesPresentStartMs{0};
+static std::atomic<bool> gPiscesWatchdogRunning{false};
+
+static inline long long piscesNowMs() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static void piscesWatchdogThread() {
+    while (true) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(500));
+        const long long start = gPiscesPresentStartMs.load();
+        if (start != 0 && piscesNowMs() - start > 1000) {
+            __android_log_print(ANDROID_LOG_ERROR, "pisces-wd",
+                    "presentDisplay stuck for %lld ms (normal is under 100 ms), restarting the composer",
+                    piscesNowMs() - start);
+            _exit(1);
+        }
+    }
+}
+
+static inline void piscesEnsureWatchdog() {
+    bool expected = false;
+    if (gPiscesWatchdogRunning.compare_exchange_strong(expected, true)) {
+        std::thread(piscesWatchdogThread).detach();
+    }
+}
