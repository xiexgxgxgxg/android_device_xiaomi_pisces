 namespace android {
 
+// pisces: the legacy camera provider is torn down (and restarted) whenever a
+// client closes the camera, so a HIDL call can fail with DEAD_OBJECT at any
+// time.  Passing the failed Return<> to mapToStatusT() converts it to Status,
+// which trips return_status::assertOk() and aborts cameraserver - that is what
+// used to kill the whole camera session and leave the viewfinder black.
+// Report the failure to the caller instead.
+// pisces: same as above for the fire-and-forget HIDL calls; the Return<>
+// destructor aborts cameraserver when the call was not checked and failed.
+static void piscesCheckCall(const hardware::Return<void>& ret, const char* what) {
+    if (!ret.isOk()) {
+        ALOGE("%s: HIDL call failed: %s", what, ret.description().c_str());
+    }
+}
+
+static status_t piscesHidlStatus(
+        const hardware::Return<hardware::camera::common::V1_0::Status>& ret) {
+    if (!ret.isOk()) {
+        ALOGE("HIDL camera call failed: %s", ret.description().c_str());
+        return DEAD_OBJECT;
+    }
+    return CameraProviderManager::mapToStatusT(ret);
+}
+
+
