diff --git a/private/pisces.te b/private/pisces.te
new file mode 100644
index 00000000..8f1755be
--- /dev/null
+++ b/private/pisces.te
@@ -0,0 +1,310 @@
+# pisces: workarounds caused by running a modern policy on a 3.4 kernel.
+#
+# On this kernel the per-node sysfs labels from genfs_contexts do not take
+# effect: everything below /sys ends up with the generic sysfs type instead of
+# sysfs_lowmemorykiller / sysfs_power / sysfs_devices_system_cpu / ...  The
+# msm8974 (cancro/virgo, Mi 3 WCDMA / Mi 4 / Mi Note) 3.4 trees carry the same
+# workaround in their device sepolicy:
+#
+#   sepolicy/init.te : allow init sysfs:file { setattr rw_file_perms };
+#   sepolicy/lmkd.te : allow lmkd sysfs:file write;
+#
+# Consequences without it:
+#   * init cannot chown/chmod /sys/module/lowmemorykiller/parameters/* nor
+#     /sys/power/* (init.rc "boot" action), and
+#   * lmkd's access("/sys/module/lowmemorykiller/parameters/minfree", W_OK)
+#     fails, so lmkd falls back to PSI/vmpressure (not available on 3.4),
+#     exits, and init reboots the device because lmkd is a critical service:
+#     "critical process 'lmkd' exited 4 times in 4 minutes".
+#
+# init may only get setattr here: AOSP already has
+#   neverallow init sysfs:file { open read write };
+allow init sysfs:file setattr;
+
+# lmkd needs getattr/open/write/append to program the in-kernel LMK.
+allow lmkd sysfs:file w_file_perms;
+
+# ---- generic sysfs grants for the enforcing bring-up ----------------------
+# On 3.4 the per-node sysfs labels are not applied (see above), so every
+# service that AOSP expects to find a sysfs_* type has to be granted on the
+# generic sysfs type instead.  Only domains that exist in the Android 9 policy
+# are listed here; the hal_*_default domains used by the earlier msm8974 trees
+# are Android 10+ and do not exist here.
+allow hwservicemanager sysfs:file r_file_perms;
+allow drmserver sysfs:file r_file_perms;
+allow toolbox sysfs:file r_file_perms;
+allow vold_prepare_subdirs sysfs:file r_file_perms;
+allow zygote sysfs:file r_file_perms;
+allow shell sysfs:file r_file_perms;
+
+# init programs the USB gadget through sysfs (init.modem_sprd.rc) and needs to
+# write those nodes for adbd to ever come up.
+allow init sysfs_android_usb:file w_file_perms;
+
+# init.rc programs the CPU governor and USB gadget through sysfs, and vold
+# reads the /proc/mounts symlink (a symlink on 3.4, a file on 4.x).
+allow init sysfs_devices_system_cpu:file w_file_perms;
+allow init sysfs_android_usb:file r_file_perms;
+allow init sysfs_android_usb:lnk_file r_file_perms;
+allow vold proc_mounts:lnk_file r_file_perms;
+
+# /proc/pisces_kmsg: the kernel log, exposed by the log saver so adb shell can
+# read SELinux denials on a running enforcing device (shell cannot read the
+# kernel log through klogctl and there is no root without Magisk).
+type proc_pisces_kmsg, fs_type, proc_type;
+allow shell proc_pisces_kmsg:file r_file_perms;
+
+# The Tegra EGL/gralloc code checks /sys/.../tegra_chip_id and tegra_chip_rev
+# at startup; without the read it dereferences what it got and crashes.
+allow surfaceflinger sysfs:file r_file_perms;
+
+# Every 32-bit exec makes the kernel request a binfmt-personality module; the
+# denial is harmless but the rate-limited audit buffer then drops the denials
+# that actually matter.
+allow domain kernel:system module_request;
+
+# pisces: init programs the Tegra power/thermal knobs under /sys/module and
+# the host1x devfreq nodes.  Give them real types so the (neverallow-protected)
+# generic sysfs type does not block init's writes.
+type sysfs_cpuidle, fs_type, sysfs_type;
+type sysfs_emc, fs_type, sysfs_type;
+allow init sysfs_cpuidle:file rw_file_perms;
+allow init sysfs_emc:file rw_file_perms;
+
+
+# The Android linker resolves memfd-backed libraries (the NVIDIA GL driver
+# loads libcgdrv.so that way) through /proc/self/fd/N; without the readlink the
+# driver comes up half-initialised and every GPU submission times out.
+allow domain proc:lnk_file r_file_perms;
+
+# The NVIDIA GL driver identifies the SoC by reading the tegra_fuse module
+# parameters.  Without them it falls back to "Tegra2", computes the wrong GPU
+# parameters and every gr3d submission times out (the display then stays black
+# because surfaceflinger blocks forever on the first fence).  The values are
+# public SoC information, so everybody may read them.
+type sysfs_tegra_fuse, fs_type, sysfs_type;
+allow { domain -isolated_app } sysfs_tegra_fuse:file r_file_perms;
+allow { domain -isolated_app } sysfs_tegra_fuse:dir r_dir_perms;
+
+# Battery (max170xx) and charger nodes are plain sysfs on this kernel, and
+# healthd reads them through /sys/class/power_supply; without it the framework
+# reports present=false and shows the red "!" instead of a percentage.
+allow healthd sysfs:file r_file_perms;
+allow healthd sysfs:dir r_dir_perms;
+allow charger sysfs:file r_file_perms;
+allow charger sysfs:dir r_dir_perms;
+
+# init sets the panel brightness from init.pisces.rc.
+allow init sysfs_leds:file rw_file_perms;
+
+# Camera: the tegra shim stores per-sensor parameters under /data.
+allow cameraserver system_data_file:file r_file_perms;
+allow cameraserver system_data_file:dir r_dir_perms;
+# ... and the newer shim keeps them in /data/misc/pisces_camera
+# (labeled camera_data_file).  cameraserver reads the blobs the camera HAL
+# wrote there; without it the camera shim falls back to default parameters.
+allow cameraserver camera_data_file:dir r_dir_perms;
+allow cameraserver camera_data_file:file r_file_perms;
+allow cameraserver camera_data_file:file w_file_perms;
+
+# Several device services run in the init domain on this board (fild, the
+# tegra AVP channel users) and need the legacy tty / video nodes.
+allow init serial_device:chr_file rw_file_perms;
+allow init video_device:chr_file rw_file_perms;
+
+# /sys/class/rfkill controls the BCM43341 power; init drives it at boot and the
+# BT HAL reads it back.  Without the label init's write is blocked by the
+# generic-sysfs neverallow and the chip never powers up (HCI commands time out).
+# init also chmod/chown the rfkill nodes for the bluetooth user, which needs
+# setattr: without it the nodes stay root:root 0644 and bt_upio cannot power
+# the chip on ("open(.../state) for write failed: Permission denied").
+allow init sysfs_rfkill:file { rw_file_perms setattr };
+allow init sysfs_rfkill:dir r_dir_perms;
+allow bluetooth sysfs_rfkill:file r_file_perms;
+allow bluetooth sysfs_rfkill:dir r_dir_perms;
+
+# The BT HAL (bt_upio in android.hardware.bluetooth@1.0-impl) powers the
+# BCM43341 through /sys/class/rfkill/rfkill0/state and reads .../type back.
+# Without it every HCI download times out:
+#   bt_upio: init_rfkill : open(/sys/class/rfkill/rfkill0/type) failed: EACCES
+#   bt_core_module: module_start_up Failed to start up module "hci_module"
+# ---- audit-spam / real gaps found on the 2026-11-12 enforcing boot --------
+# storaged polls /sys/block/mmcblk0/stat, which is plain sysfs on this kernel
+# (there is no genfscon for /block), so r_dir_file(storaged, sysfs_disk_stat)
+# never matches: 458 denials per boot, all dropped by the audit rate limit.
+allow storaged sysfs:file r_file_perms;
+allow storaged sysfs:dir r_dir_perms;
+
+# netd keeps the 3.4 qtaguid accounting alive by writing
+# /proc/net/xt_qtaguid/ctrl; the /proc/net path is not labeled on this kernel,
+# so the write lands on the generic proc type (2650 denials per boot).
+allow netd proc:file w_file_perms;
+
+# fild (the Xiaomi factory daemon) runs in the init domain and keeps reading
+# its netlink kobject-uevent socket.  Denying the read makes it poll in a tight
+# loop: "audit_lost" grew by ~20-30k messages per second and the rate limiter
+# (5/s) threw away every other denial in the buffer, including the camera
+# ones.  Reading the socket is harmless, so let it through.
+allow init self:netlink_kobject_uevent_socket { read write };
+
+# The FUSE storage daemon chowns/chmods /data/media/0/DCIM/Camera when the
+# camera app creates it; without CAP_FOWNER the chmod fails and the directory
+# keeps the wrong mode ("sdcard: chmod failed ... Operation not permitted").
+# sdcardd (the FUSE daemon behind /storage/emulated) needs fsetid as well as
+# dac_override/fowner: without it open/create on behalf of an app fails with
+# EACCES, which shows up as "MtpServer: ... Permission denied" and aborts the
+# USB transfer.  The unlabeled rules cover files pushed by adb/TWRP before
+# restorecon could run on this port.
+allow sdcardd self:global_capability_class_set { dac_override fowner fsetid };
+allow sdcardd unlabeled:file r_file_perms;
+allow sdcardd unlabeled:dir r_dir_perms;
+
+# CameraService walks /sys/class/leds while resolving the torch target (it is
+# a symlink to /sys/devices/virtual/leds, which is now labeled sysfs_leds).
+# The coredomain neverallow only covers sysfs_leds:file, not the directory.
+allow cameraserver sysfs_leds:dir r_dir_perms;
+allow cameraserver sysfs_leds:lnk_file read;
+
+# Debug aid: adb shell (uid 2000) must be able to open the ALSA control node to
+# run tinymix while the ES325 -> CS42L73 path is being debugged.
+allow shell audio_control_device:chr_file rw_file_perms;
+allow audioserver audio_control_device:chr_file rw_file_perms;
+
+
+# pisces: AudioFlinger's ApmOutput thread takes /sys/power/wake_lock for the
+# duration of playback.  Without it the write path bails out and the primary
+# output stays silent under enforcing (permissive hides it).
+allow audioserver sysfs_wake_lock:dir r_dir_perms;
+allow audioserver sysfs_wake_lock:file rw_file_perms;
+
+# pisces: /system/bin/media_omx_service runs the Nvidia OMX HIDL HAL from the
+# system partition (it needs the Nvidia OMX components in /system/lib).  init
+# may not exec a plain system_file, so give the binary its own exec type and
+# transition into the AOSP "mediacodec" media-HAL domain.
+type media_omx_exec, exec_type, file_type;
+domain_auto_trans(init, media_omx_exec, mediacodec)
+
+# pisces: the ES325 firmware is downloaded over /dev/ttyHS3 by vpcmd at boot.
+# It used to run as "init exec /system/bin/sh script", which SELinux cannot
+# allow (init may not exec shell), so under enforcing the DSP never got its
+# firmware and the whole audio path stayed silent.  Run vpcmd directly in its
+# own daemon domain instead.
+type es325_fw, domain;
+type es325_fw_exec, exec_type, file_type;
+init_daemon_domain(es325_fw)
+allow es325_fw serial_device:chr_file rw_file_perms;
+allow es325_fw system_file:file { read open getattr map execute };
+allow es325_fw system_file:dir { open read getattr search };
+allow es325_fw self:process { execmem };
+# vpcmd resets the chip through /sys/esxxx/reset and reads uart_download
+allow es325_fw sysfs:dir r_dir_perms;
+allow es325_fw sysfs:file rw_file_perms;
+
+# pisces: CPU hotplug/frequency tuning used to run as a shell script started by
+# init, which enforcing forbids (init -> shell_exec execute_no_trans).  Run the
+# C replacement in its own domain so it can still program cpufreq.
+type pisces_cpu, domain;
+type pisces_cpu_exec, exec_type, file_type;
+init_daemon_domain(pisces_cpu)
+allow pisces_cpu sysfs:dir r_dir_perms;
+allow pisces_cpu sysfs:file rw_file_perms;
+allow pisces_cpu sysfs_devices_system_cpu:dir r_dir_perms;
+allow pisces_cpu sysfs_devices_system_cpu:file rw_file_perms;
+allow pisces_cpu system_file:file { read open getattr map execute };
+allow pisces_cpu self:process { execmem };
+get_prop(pisces_cpu, exported3_system_prop)
+
+# pisces: fild loads the Spreadtrum modem firmware over SPI (fdl1.bin etc.) and
+# keeps the modem alive.  Under enforcing init cannot exec it (126/127), the
+# modem never boots, rild's AT channel fails and rild crashes in the vendor
+# blob ("at_channel_writer_destroy"), which is why the baseband stayed
+# "unknown".  Run it in its own daemon domain.
+type fild_data_file, file_type, data_file_type, core_data_file_type;
+type fild, domain;
+type fild_exec, exec_type, file_type;
+init_daemon_domain(fild)
+allow fild system_file:file { read open getattr map execute execute_no_trans };
+allow fild system_file:dir { read open getattr search };
+allow fild radio_device:chr_file rw_file_perms;
+allow fild radio_device:dir r_dir_perms;
+allow fild serial_device:chr_file rw_file_perms;
+allow fild sysfs:dir r_dir_perms;
+allow fild sysfs:file rw_file_perms;
+allow fild sysfs_wake_lock:dir r_dir_perms;
+allow fild sysfs_wake_lock:file rw_file_perms;
+allow fild self:process execmem;
+# fild creates /data/fild on its own (the port's restorecon cannot relabel it)
+allow fild system_data_file:dir { create write add_name };
+# the port's restorecon cannot relabel /data/fild, so the fifo lands in the
+# generic data type
+allow fild system_data_file:fifo_file { create open read write getattr };
+allow fild fild_data_file:dir rw_dir_perms;
+allow fild fild_data_file:file rw_file_perms;
+# The state fifo is labeled fild_data_file (plat_file_contexts has
+# /data/fild(/.*)?), so the file rule above does not cover it.  Without this
+# fild's main loop cannot read the modem state and treats every read as 0:
+#   avc: denied { read } ... tclass=fifo_file
+allow fild fild_data_file:fifo_file rw_file_perms;
+
+# fild keeps a second thread on a kobject-uevent netlink socket: it parses
+# SC8800G_MDM_STATE=... events and forwards them to the state fifo.  When the
+# socket creation was denied the whole thread exited before it ever wrote the
+# initial state, so the main loop spun on "Modem power is off":
+#   avc: denied { create } ... tclass=netlink_kobject_uevent_socket
+allow fild self:netlink_kobject_uevent_socket { create bind read write setopt };
+
+# fild spawns /system/bin/sh helpers (its system() calls) and fdl; those
+# execute toybox applets.  fdl also opens the modem images through
+# /dev/block/platform/.../by-name, which resolve to block_device nodes.
+# Without these, the OTA-built system lets fild start but fdl cannot read
+# MDM/MLO/MRO/MRW, so the firmware transfer never happens and the baseband
+# stays empty (the old hand-patched image happened to carry them).
+allow fild toolbox_exec:file rx_file_perms;
+allow fild block_device:dir r_dir_perms;
+allow fild block_device:lnk_file r_file_perms;
+type modem_block_device, dev_type;
+allow fild modem_block_device:blk_file rw_file_perms;
+
+# fild does not use file I/O for modem power/reset: it runs
+#   system("echo 1 > /sys/class/spi_master/spi0/spi0.0/pwr_onoff")
+# (and the same for reset / gpio56 / usb_switch) through /system/bin/sh.
+# Without the shell exec below every power-on attempt fails with
+#   avc: denied { execute } for name="sh" scontext=u:r:fild:s0
+# and fild loops forever on "Modem power is off, try to turn it on.".
+# There is no domain transition, so sh keeps the fild context and the generic
+# sysfs write above covers the actual store.
+allow fild shell_exec:file rx_file_perms;
+
+# fild stops ril-daemon before downloading the modem images and starts it
+# again once the modem is ACTIVE ("stop ril-daemon"/"start ril-daemon").
+set_prop(fild, ctl_start_prop)
+set_prop(fild, ctl_stop_prop)
+
+# ---- Magisk 31.x compatibility -------------------------------------------
+# MagiskSU adds one allow statement that lists every app domain at once:
+#   allow { zygote shell platform_app platform_app_all system_app
+#           priv_app priv_app_all untrusted_app untrusted_app_all }
+#         magisk unix_stream_socket { connectto getopt };
+# Android 9 knows untrusted_app_all but not platform_app_all/priv_app_all
+# (those were introduced with the Android 11 policy split).  An unknown
+# attribute makes magiskpolicy drop the whole statement, so the Magisk app's
+# "su" cannot reach magiskd and the home screen reports "not installed" even
+# though the daemon is running.  Define the missing attributes as aliases so
+# the statement applies on this policy.
+attribute platform_app_all;
+attribute priv_app_all;
+typeattribute platform_app platform_app_all;
+typeattribute priv_app priv_app_all;
+
+# The port's zygote/SELinux setcon workaround leaves some early app processes
+# in the zygote domain.  They still receive ashmem fds (MemoryIntArray) from
+# system_server over binder; without the fd use permission every Bundle that
+# carries one fails with "Error unparceling MemoryIntArray" and the telephony
+# provider / CryptKeeper crash, which also leaves gsm.version.baseband unset.
+allow zygote system_server:fd use;
+
+# MtpServer runs in the MediaProvider app process, which this port labels
+# platform_app (the mediaprovider domain is only used by
+# android.process.media).  Without this the MTP server cannot open
+# /dev/mtp_usb and the host sees a non-functional MTP interface.
+allow platform_app mtp_device:chr_file rw_file_perms;
