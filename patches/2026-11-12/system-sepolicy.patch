diff --git a/public/pisces.te b/public/pisces.te
new file mode 100644
index 00000000..0034fa99
--- /dev/null
+++ b/public/pisces.te
@@ -0,0 +1,15 @@
+# Types shared between the platform and vendor policy for this device.
+#
+# system/sepolicy/private/ and system/sepolicy/vendor/ are compiled as
+# separate policy modules: a type declared in private/ is invisible to the
+# vendor *.te files, so anything both sides have to name lives here.
+
+# /sys/class/rfkill: the BCM43341 power switch.  It needs its own type because
+# init may not write the generic sysfs type (neverallow init sysfs:file write)
+# and the Bluetooth HAL (a vendor domain) has to drive the same nodes.
+type sysfs_rfkill, fs_type, sysfs_type;
+
+# ALSA control node (/dev/snd/controlC0).  Kept separate from the generic
+# audio_device type so that the audio HAL keeps its access while adb shell can
+# be granted the node for tinymix/tinyplay during bring-up debugging.
+type audio_control_device, dev_type;
