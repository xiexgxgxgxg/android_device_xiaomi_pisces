+++ b/vendor/hal_usb_gadget_default.te
@@ -0,0 +1,31 @@
+# pisces: the USB gadget HAL ships as a vendor binary named
+# android.hardware.usb.gadget@1.0-service.pisces.  AOSP's vendor policy has the
+# hal_usb_gadget attributes but no default domain, so the binary stayed
+# vendor_file and init refused to exec it ("execute_no_trans"), which left
+# system_server waiting forever for IUsbGadget/default and the boot stuck on
+# the boot animation.
+type hal_usb_gadget_default, domain;
+hal_server_domain(hal_usb_gadget_default, hal_usb_gadget)
+
+type hal_usb_gadget_default_exec, exec_type, vendor_file_type, file_type;
+init_daemon_domain(hal_usb_gadget_default)
+
+# This board exposes the legacy /sys/class/android_usb gadget rather than
+# configfs, and the .pisces HAL drives that interface directly.
+allow hal_usb_gadget_default sysfs_android_usb:file rw_file_perms;
+allow hal_usb_gadget_default sysfs_android_usb:dir r_dir_perms;
+allow hal_usb_gadget_default sysfs_android_usb:lnk_file r_file_perms;
+allow hal_usb_gadget_default sysfs:file rw_file_perms;
+allow hal_usb_gadget_default sysfs:dir r_dir_perms;
+
+# It also needs to poke adbd and the USB state properties.
+allow hal_usb_gadget_default adbd:unix_stream_socket connectto;
+allow hal_usb_gadget_default adbd_socket:sock_file write;
+allow hal_usb_gadget_default system_radio_prop:property_service set;
+allow hal_usb_gadget_default ffs_prop:property_service set;
+# The pisces gadget HAL sets sys.usb.config / sys.usb.state from its binder
+# thread; the property type is already allowed, but the property service
+# socket itself was not, so every setCurrentUsbFunctions() failed with
+# EACCES and UsbDeviceManager fell back to charging-only.
+allow hal_usb_gadget_default property_socket:sock_file write;
+allow hal_usb_gadget_default init:unix_stream_socket connectto;
diff --git a/vendor/hal_wifi_default.te b/vendor/hal_wifi_default.te
index 75a98429..1469725c 100644
--- a/vendor/hal_wifi_default.te
+++ b/vendor/hal_wifi_default.te
@@ -3,3 +3,9 @@ hal_server_domain(hal_wifi_default, hal_wifi)
 
 type hal_wifi_default_exec, exec_type, vendor_file_type, file_type;
 init_daemon_domain(hal_wifi_default)
+
+# pisces: the Broadcom WiFi HAL writes the firmware/nvram paths into the
+# bcmdhd sysfs attributes during interface creation.  With SELinux enforcing
+# from the very first seconds this write is what makes "WiFi won't turn on".
+allow hal_wifi_default sysfs:dir r_dir_perms;
+allow hal_wifi_default sysfs:file rw_file_perms;
diff --git a/vendor/pisces_rild.te b/vendor/pisces_rild.te
new file mode 100644
index 00000000..60f499a1
--- /dev/null
+++ b/vendor/pisces_rild.te
@@ -0,0 +1,5 @@
+# pisces: the Spreadtrum modem exposes its multiplexer as /dev/ts0710mux*;
+# rild talks to the modem through them.  They used to keep the default
+# "device" label, so rild was denied and the baseband never came up.
+allow rild radio_device:dir r_dir_perms;
+allow rild radio_device:chr_file rw_file_perms;
