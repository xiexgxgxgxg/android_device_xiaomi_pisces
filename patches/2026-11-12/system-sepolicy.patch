index 01d60dbb..0a4adab5 100644
--- a/vendor/hal_bluetooth_default.te
+++ b/vendor/hal_bluetooth_default.te
@@ -3,3 +3,25 @@ hal_server_domain(hal_bluetooth_default, hal_bluetooth)
 
 type hal_bluetooth_default_exec, exec_type, vendor_file_type, file_type;
 init_daemon_domain(hal_bluetooth_default)
+
+# pisces: the BCM43341 needs its MAC address from /data and talks over the
+# legacy UART node /dev/ttyHS2 (both denied by the stock policy).
+allow hal_bluetooth_default bluetooth_data_file:file r_file_perms;
+allow hal_bluetooth_default bluetooth_data_file:dir r_dir_perms;
+allow hal_bluetooth_default serial_device:chr_file rw_file_perms;
+
+# bt_upio powers the BCM43341 through /sys/class/rfkill/rfkill0/state and reads
+# .../type back.  Without this every HCI firmware download times out:
+#   bt_upio: init_rfkill : open(/sys/class/rfkill/rfkill0/type) failed: EACCES
+#   bt_core_module: module_start_up Failed to start up module "hci_module"
+allow hal_bluetooth_default sysfs_rfkill:file rw_file_perms;
+allow hal_bluetooth_default sysfs_rfkill:dir r_dir_perms;
+
+# The HCI thread asks for SCHED_FIFO; without sys_nice it falls back to
+# SCHED_OTHER ("ThreadRoutine unable to set SCHED_FIFO ... Operation not
+# permitted") on a 921600 baud UART.
+allow hal_bluetooth_default self:global_capability_class_set sys_nice;
+
+
+allow hal_bluetooth_default sysfs:dir r_dir_perms;
+allow hal_bluetooth_default sysfs:file rw_file_perms;
diff --git a/vendor/hal_camera_default.te b/vendor/hal_camera_default.te
index 5bc4a619..54f93923 100644
--- a/vendor/hal_camera_default.te
+++ b/vendor/hal_camera_default.te
@@ -9,3 +9,63 @@ allow hal_camera_default fwk_sensor_hwservice:hwservice_manager find;
 # For collecting bugreports.
 allow hal_camera_default dumpstate:fd use;
 allow hal_camera_default dumpstate:fifo_file write;
+
+# pisces: the NVIDIA camera blobs ship libFaceProc.so (and friends) with text
+# relocations, so the linker needs PROT_EXEC on a private writable mapping.
+# Without it every open of camera 0 fails:
+#   avc: denied { execmod } for path="/system/lib/libFaceProc.so"
+#   CameraWrapper: failed to dlopen vendor camera module:
+#       dlopen failed: can't protect segments for "...libFaceProc.so":
+#       Permission denied
+#   CameraProviderManager: openSession: giving up on camera 0 after 14 attempts
+#   CameraService: Failed to initialize camera "0": Broken pipe (-32)
+# This also takes the torch (status bar flashlight tile) down with it.
+# TARGET_NEEDS_PLATFORM_TEXT_RELOCATIONS := true in BoardConfig.mk is what
+# makes this rule legal (see the execmod neverallow in public/domain.te).
+allow hal_camera_default system_file:file execmod;
+allow hal_camera_default vendor_file:file execmod;
+
+# The status bar flashlight tile goes through CameraService.setTorchMode().
+# The wrapper module is CAMERA_MODULE_API_VERSION_1_0, so the provider falls
+# back to opening the camera and setting "flash-mode=torch"; the wrapper then
+# drives the LED through /sys/class/leds/flashlight/brightness (see
+# set_flash_led() in hardware/nvidia/pisces/camera/CameraWrapper.cpp).  The
+# /sys/class/leds subtree is labeled sysfs_leds, and without the write the
+# tile click silently does nothing:
+#   set_flash_led: cannot open the flashlight node
+allow hal_camera_default sysfs_leds:file rw_file_perms;
+allow hal_camera_default sysfs_leds:lnk_file read;
+allow hal_camera_default sysfs_leds:dir r_dir_perms;
+allow hal_camera_default sysfs:dir r_dir_perms;
+
+# The 2013 NVIDIA HAL talks to the host1x/NvRM device nodes directly (it does
+# not go through gralloc): /dev/nvhost-ctrl, /dev/nvhost-vi, /dev/nvhost-isp,
+# /dev/nvmap ... are all labeled gpu_device on this port.  Without the access
+# nvrm_init() fails before the sensor is even touched:
+#   NvOsDebugPrintf: ****nvrm_init failed****
+#   NvOsDebugPrintf: Error: Can't open /dev/nvhost-ctrl
+#   NvCameraHal: setupHalInLock:539 failed to open camera! Error: 0x3
+# (the gpu_device neverallow only restricts halserverdomain other than
+# hal_camera_server, and hal_camera_default is hal_camera_server)
+allow hal_camera_default gpu_device:chr_file rw_file_perms;
+allow hal_camera_default gpu_device:dir r_dir_perms;
+
+# NvRM/NvCamera read /sys/devices/platform/host1x/... and the devfreq knobs
+# while initialising.
+allow hal_camera_default sysfs:file r_file_perms;
+
+# The camera wrapper caches the per-sensor shim parameters in
+# /data/misc/pisces_camera (labeled camera_data_file).
+allow hal_camera_default camera_data_file:dir rw_dir_perms;
+allow hal_camera_default camera_data_file:file create_file_perms;
+# NOTE: the NvMM cache in /data/misc/pisces_camera is still labeled
+# system_data_file (init's restorecon is broken on this port, see the
+# restorecon failures in dmesg) and domain.te forbids granting write on
+# system_data_file to a vendor HAL, so that cache is simply not usable yet.
+# It is a performance cache only; the camera works without it.
+
+# camera_device_close() forks a child that SIGKILLs the provider (the 2013
+# vendor HAL cannot be closed twice), so the domain must be able to signal
+# itself.
+allow hal_camera_default self:process signal;
+
