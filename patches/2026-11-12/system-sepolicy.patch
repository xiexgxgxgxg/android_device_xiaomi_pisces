+genfscon sysfs /module/tegra11_emc u:object_r:sysfs_emc:s0
+genfscon sysfs /module/tegra_fuse u:object_r:sysfs_tegra_fuse:s0
+genfscon sysfs /class/backlight u:object_r:sysfs_leds:s0
+genfscon sysfs /class/rfkill u:object_r:sysfs_rfkill:s0
+
+# pisces: /sys/class/rfkill/rfkill0 is a symlink; the real bcmdhd/bluedroid_pm
+# nodes live under the platform device.  Without this the bluetooth HAL and
+# init (chmod 0660 + power toggling) are denied on the canonical path.
+genfscon sysfs /devices/platform/bluedroid_pm/rfkill u:object_r:sysfs_rfkill:s0
+genfscon sysfs /devices/virtual/rfkill u:object_r:sysfs_rfkill:s0
