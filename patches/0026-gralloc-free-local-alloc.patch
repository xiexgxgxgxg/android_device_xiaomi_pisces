 static constexpr Error kTransactionError = Error::NO_RESOURCES;
 
+// pisces: buffers allocated by allocateLocally() are handed to the mapper,
+// which clones the native handle and keeps the clone.  The nvmap memory still
+// belongs to the original handle returned by gralloc, and nothing ever frees
+// it: every buffer libui releases leaked its allocation.  SurfaceFlinger had
+// 790 MB of nvmap resident and eglCreateWindowSurface started failing with
+// EGL_BAD_ALLOC, which crash-looped SystemUI.
+//
+// Remember clone -> original and hand the memory back in Mapper::freeBuffer().
+std::mutex gLocalGrallocMutex;
+alloc_device_t* gLocalGrallocDevice = nullptr;
+std::map<const native_handle_t*, const native_handle_t*> gLocalGrallocOrigins;
+
+// Caller must hold gLocalGrallocMutex.
+alloc_device_t* getLocalGrallocDeviceLocked() {
+    if (gLocalGrallocDevice != nullptr) {
+        return gLocalGrallocDevice;
+    }
+
+    gralloc_module_t const* module = nullptr;
+    if (hw_get_module(GRALLOC_HARDWARE_MODULE_ID,
+            reinterpret_cast<const hw_module_t**>(&module)) != 0) {
+        ALOGE("pisces: local gralloc module not found");
+        return nullptr;
+    }
+
+    alloc_device_t* device = nullptr;
+    if (gralloc_open(reinterpret_cast<const hw_module_t*>(module), &device) != 0 ||
+            device == nullptr) {
+        ALOGE("pisces: local gralloc open failed");
+        return nullptr;
+    }
+
+    gLocalGrallocDevice = device;
+    return device;
+}
