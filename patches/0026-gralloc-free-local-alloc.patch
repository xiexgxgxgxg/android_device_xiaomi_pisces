@@ -165,11 +202,31 @@
 void Mapper::freeBuffer(buffer_handle_t bufferHandle) const
 {
     auto buffer = const_cast<native_handle_t*>(bufferHandle);
+
+    // pisces: if this handle was allocated locally, it is the mapper's clone
+    // and the real allocation is the original handle we stashed away.
+    const native_handle_t* origin = nullptr;
+    alloc_device_t* device = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(gLocalGrallocMutex);
+        auto it = gLocalGrallocOrigins.find(buffer);
+        if (it != gLocalGrallocOrigins.end()) {
+            origin = it->second;
+            gLocalGrallocOrigins.erase(it);
+            device = gLocalGrallocDevice;
+        }
+    }
+
     auto ret = mMapper->freeBuffer(buffer);
 
     auto error = (ret.isOk()) ? static_cast<Error>(ret) : kTransactionError;
     ALOGE_IF(error != Error::NONE, "freeBuffer(%p) failed with %d",
             buffer, error);
+
+    if (origin != nullptr && device != nullptr) {
+        int res = device->free(device, const_cast<native_handle_t*>(origin));
+        ALOGE_IF(res != 0, "pisces: local gralloc free failed: %d", res);
+    }
 }
 
