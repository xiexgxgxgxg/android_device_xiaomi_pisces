+    /** Encodes the camera preview frames into a video-only file. */
+    private void startPreviewVideoRecorder() {
+        if (mPreviewRecorder != null || mCameraDevice == null) {
+            return;
+        }
+        // Keep the recorded (== preview) size small: the software H.264 encoder
+        // cannot keep up with 1024x576/720p, which made the preview stutter and
+        // the encoded track drift away from the audio.
+        Camera.Size current = mParameters.getPreviewSize();
+        if (current != null && current.width * current.height > 640 * 480) {
+            Camera.Size best = null;
+            for (Camera.Size size : mParameters.getSupportedPreviewSizes()) {
+                if (size.width * size.height <= 640 * 480
+                        && (best == null || size.width * size.height
+                                > best.width * best.height)) {
+                    best = size;
+                }
+            }
+            if (best != null) {
+                mParameters.setPreviewSize(best.width, best.height);
+                mCameraDevice.setParameters(mParameters);
+                Log.i(TAG, "recording preview lowered to " + best.width + "x" + best.height);
+            }
+        }
+        Camera.Size previewSize = mParameters.getPreviewSize();
+        int width = previewSize != null ? previewSize.width : mProfile.videoFrameWidth;
+        int height = previewSize != null ? previewSize.height : mProfile.videoFrameHeight;
+        mVideoTempPath = new File(mActivity.getCacheDir(), "recording.mp4.video").getAbsolutePath();
+        mPreviewRecorder = new PreviewVideoRecorder();
+        mPreviewRecorder.setAudioEnabled(false);
+        try {
+            int bitRate = Math.min(mProfile.videoBitRate, width * height * 4);
+            mPreviewRecorder.start(width, height, mProfile.videoFrameRate,
+                    bitRate, mVideoTempPath, mMediaRecorderRotationHint);
+        } catch (Exception e) {
+            Log.e(TAG, "cannot start the preview recorder", e);
+            mPreviewRecorder = null;
+            mVideoTempPath = null;
+            return;
+        }
+        mRecorderThread = new HandlerThread("VideoRecorder");
+        mRecorderThread.start();
+        mRecorderHandler = new Handler(mRecorderThread.getLooper());
+        mRecorderBuffer = new byte[width * height * 3 / 2];
+        mCameraDevice.addCallbackBuffer(mRecorderBuffer);
+        mCameraDevice.setPreviewDataCallbackWithBuffer(mRecorderHandler,
+                new CameraManager.CameraPreviewDataCallback() {
+                    @Override
+                    public void onPreviewFrame(byte[] data, CameraManager.CameraProxy camera) {
+                        PreviewVideoRecorder recorder = mPreviewRecorder;
+                        if (recorder != null) {
+                            recorder.offerFrame(data);
+                        }
+                        if (mCameraDevice != null) {
+                            mCameraDevice.addCallbackBuffer(data);
+                        }
+                    }
+                });
+        Log.i(TAG, "preview video recorder started at " + width + "x" + height);
+    }
+
+    /** Stops the video recorder and merges its track with the audio file. */
+    private void stopPreviewVideoRecorder(String audioPath) {
+        if (mCameraDevice != null && mRecorderHandler != null) {
+            mCameraDevice.setPreviewDataCallbackWithBuffer(mRecorderHandler, null);
+        }
+        PreviewVideoRecorder recorder = mPreviewRecorder;
+        mPreviewRecorder = null;
+        if (recorder != null) {
+            recorder.stop();
+        }
+        if (mRecorderThread != null) {
+            mRecorderThread.quitSafely();
+            mRecorderThread = null;
+            mRecorderHandler = null;
+        }
+        mRecorderBuffer = null;
+        String videoPath = mVideoTempPath;
+        mVideoTempPath = null;
+        if (videoPath == null || audioPath == null) {
+            Log.w(TAG, "nothing to merge (video=" + videoPath + ", audio=" + audioPath + ")");
+            return;
+        }
+        String mergedPath = new File(mActivity.getCacheDir(), "recording.merged.mp4")
+                .getAbsolutePath();
+        if (PreviewVideoRecorder.remux(videoPath, audioPath, mergedPath,
+                mMediaRecorderRotationHint)) {
+            publishRecording(mergedPath, audioPath);
+            new File(videoPath).delete();
+            new File(audioPath).delete();
+            new File(mergedPath).delete();
+        } else {
+            Log.e(TAG, "could not merge the video track, keeping " + videoPath);
+        }
+    }
+
+    /**
+     * Copies the finished recording into the media directory as a hidden file
+     * first (the media scanner ignores those) and renames it into place, so the
+     * camera directory never contains a half written video.
+     */
+    private void publishRecording(String sourcePath, String finalPath) {
+        File target = new File(finalPath);
+        File hidden = new File(target.getParentFile(), "." + target.getName() + ".part");
+        try {
+            FileInputStream in = new FileInputStream(sourcePath);
+            FileOutputStream out = new FileOutputStream(hidden);
+            byte[] buffer = new byte[256 * 1024];
+            int read;
+            while ((read = in.read(buffer)) > 0) {
+                out.write(buffer, 0, read);
+            }
+            out.getFD().sync();
+            out.close();
+            in.close();
+            if (hidden.renameTo(target)) {
+                Log.i(TAG, "recording published to " + finalPath);
+            } else {
+                Log.e(TAG, "could not rename " + hidden + " to " + finalPath);
+            }
+        } catch (IOException e) {
+            Log.e(TAG, "could not publish the recording", e);
+            hidden.delete();
+        }
+    }
