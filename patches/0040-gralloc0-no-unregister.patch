+    /*
+     * pisces: bookkeeping for buffers this process imported.
+     *
+     * The composer HAL keeps its own copy of every layer buffer handle and
+     * calls freeBuffer() on it when the layer goes away.  NvGrUnregisterBuffer()
+     * assumes it is looking at a handle that NvGrRegisterBuffer() set up in
+     * *this* process (it reads the fence page pointer at offset 0x80 and the
+     * remap bookkeeping at 0xb4); running it twice - or on a copy that was
+     * never registered here - dereferences stale memory:
+     *
+     *   NvGrUnregisterBuffer+26: ldr r3, [handle, #0x80]
+     *                            ldr r0, [r3, #0x10]   <- SIGSEGV
+     *
+     * which takes down the composer service, then SurfaceFlinger, then zygote
+     * (surfaceflinger.rc has "onrestart restart zygote") - the soft reboot.
+     *
+     * Track every clone we registered, and only unregister a handle that is
+     * still in that set.  A duplicate free is then a no-op instead of a crash.
+     */
+    static std::unordered_set<const native_handle_t*>& liveHandles() {
+        static std::unordered_set<const native_handle_t*> handles;
+        return handles;
+    }
+
+    static std::mutex& liveHandlesMutex() {
+        static std::mutex mutex;
+        return mutex;
+    }
+
