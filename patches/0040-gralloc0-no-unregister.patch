     }
 
     Error freeBuffer(native_handle_t* bufferHandle) override {
+        bool live;
+        {
+            std::lock_guard<std::mutex> lock(liveHandlesMutex());
+            live = liveHandles().erase(bufferHandle) > 0;
+            ALOGE("pisces: free %p id=%d fence=%p live=%d remaining=%zu", bufferHandle,
+                  bufferHandle->data[0],
+                  reinterpret_cast<void*>(bufferHandle->data[29]),
+                  live ? 1 : 0, liveHandles().size());
+        }
+
+        if (!live) {
+            // pisces: already freed (or never registered here).  Calling
+            // NvGrUnregisterBuffer() again munmaps the fence page a second
+            // time and segfaults; just drop the duplicate.
+            ALOGE("pisces: duplicate freeBuffer(%p), skipping unregister", bufferHandle);
+            return Error::NONE;
+        }
