+static bool setup_or_bind(const std::string& source_path, const std::string& dest_path,
+                          uid_t uid, gid_t gid, userid_t userid, bool multi_user,
+                          gid_t gid_mask, int mask, bool derive_gid, bool default_normal,
+                          bool use_esdfs) {
+    if (sdcardfs_setup(source_path, dest_path, uid, gid, multi_user, userid, gid_mask, mask,
+                       derive_gid, default_normal, use_esdfs)) {
+        return true;
+    }
+    // pisces: the 3.4 kernel has no sdcardfs; expose the storage directly.
+    LOG(WARNING) << "sdcardfs unavailable for " << dest_path << ", using bind mount";
+    g_used_bind = true;
+    if (mount(source_path.c_str(), dest_path.c_str(), nullptr, MS_BIND, nullptr) != 0) {
+        PLOG(ERROR) << "bind mount failed for " << dest_path;
+        return false;
+    }
+    // pisces: a bind mount keeps the raw ownership of /data/media, so the
+    // mount point stays media_rw:media_rw 0770 and no app can even traverse
+    // into /storage/emulated/0 - the camera then reports "insert an SD card".
+    // Open the mount points up; the per-app isolation sdcardfs would give us is
+    // lost, but external storage works on this kernel.
+    if (chmod(dest_path.c_str(), 0771) != 0) {
+        PLOG(WARNING) << "chmod failed for " << dest_path;
+    }
+    return true;
+}
+
+static void relax_emulated_storage(const std::string& source_path, userid_t userid) {
+    // pisces: see setup_or_bind(); without sdcardfs the directories inside the
+    // storage root have to be writable by every app or nothing can save.
+    const std::string root = source_path + "/" + std::to_string(userid);
+    if (chmod(root.c_str(), 0777) != 0) {
+        PLOG(WARNING) << "chmod failed for " << root;
+    }
+    static const char* kDirs[] = {
+        "Alarms", "Android", "DCIM", "Documents", "Download", "Movies",
+        "Music", "Notifications", "Pictures", "Podcasts", "Ringtones",
+    };
+    for (const char* dir : kDirs) {
+        const std::string path = root + "/" + dir;
+        if (chmod(path.c_str(), 0777) != 0) {
+            PLOG(WARNING) << "chmod failed for " << path;
+        }
+    }
+}
