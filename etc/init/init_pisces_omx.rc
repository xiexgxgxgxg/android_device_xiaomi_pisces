# pisces: run the OMX HAL from /system/bin so its linker namespace can load the
# Nvidia components (libnvomx*.so in /system/lib) together with the NVOMXPlugin
# shim.  A vendor process cannot reach those libraries, which left the framework
# with the software codecs only.
#
# The stock vendor service is stopped early and this one is started with the
# other main services, so the switch happens before any app asks for a codec.
service media_omx_system /system/bin/media_omx_service
    class main
    user media
    group camera drmrpc mediadrm
    ioprio rt 4
    writepid /dev/cpuset/foreground/tasks
    disabled

on boot
    # The vendor service has already been started by its class at this point;
    # stop it so only our system-process instance owns the OMX store.
    stop vendor.media.omx
    start media_omx_system
