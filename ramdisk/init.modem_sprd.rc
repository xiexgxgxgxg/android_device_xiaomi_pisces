# Spreadtrum modem bring-up for the Mi 3 TD.
# Rewritten for Android 9 init: the stock file used the 4.x-only
# "service_redefine" keyword (which makes init reject the whole block) and the
# "class_start:main" trigger (which does not exist in A9 either).

on init
    setprop rild.libpath /system/lib/libril-xiaomi-sprd.so
    setprop rild.libargs "-d /dev/ts0710mux0"
    setprop mdm.diag_path /sdcard/offline_log/
    setprop mdm.diag_port /dev/ttyHS0
    setprop ril.ecclist "112,000,110,118,119,911,999,120,122"
    setprop persist.radio.modem "TD"

    chown system radio /sys/class/spi_master/spi0/spi0.0/reset
    chown root radio /sys/class/spi_master/spi0/spi0.0/assert
    # fild powers the modem on by running
    #   sh -c "echo 1 > /sys/.../spi0.0/pwr_onoff"
    # and reads .../state back.  The driver exports pwr_onoff as root:root
    # 0640 and state as root:root 0640, so fild (user radio) has to be given
    # group access, otherwise every attempt fails with EACCES and fild loops
    # on "Modem power is off, try to turn it on." forever.
    chown root radio /sys/class/spi_master/spi0/spi0.0/pwr_onoff
    chmod 0660 /sys/class/spi_master/spi0/spi0.0/pwr_onoff
    chown root radio /sys/class/spi_master/spi0/spi0.0/state
    chown root radio /sys/class/spi_master/spi0/spi0.0/usb_switch
    chmod 0660 /sys/class/spi_master/spi0/spi0.0/usb_switch

# fild loads fdl1.bin/modem_zip.bin into the modem over SPI and keeps the
# modem alive; without it RIL_Init cannot open a channel and rild gives up.
service fil-daemon /system/bin/fild
    class core
    # Keep the daemon on user radio: running it as root would need
    # CAP_DAC_OVERRIDE for the radio-owned /dev/ts0710mux* nodes, which the
    # AOSP policy neverallows.  The nodes it touches are chowned above.
    user radio
    group radio system
    disabled

on boot
    # The stock rc does not touch reset here; fild powers the modem with
    # pwr_onoff and the driver manages the reset line.  init may not write
    # generic sysfs at all (neverallow init sysfs:file write), so the old
    # "write .../reset 1" never did anything and only added audit noise.
    start fil-daemon

on property:ro.radio.noril=1
    stop fil-daemon

on property:persist.mdm.offline_log.enable=true
    write /sys/class/spi_master/spi0/spi0.0/offline_log 1

on property:persist.mdm.offline_log.enable=false
    write /sys/class/spi_master/spi0/spi0.0/offline_log 0

on property:sys.usb.config=diag
    write /sys/class/spi_master/spi0/spi0.0/usb_switch 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp
    write /sys/class/spi_master/spi0/spi0.0/usb_switch 0

on property:sys.usb.config=mtp,adb
    write /sys/class/spi_master/spi0/spi0.0/usb_switch 0

on property:sys.usb.config=rndis
    write /sys/class/spi_master/spi0/spi0.0/usb_switch 0

on property:sys.usb.config=rndis,adb
    write /sys/class/spi_master/spi0/spi0.0/usb_switch 0

on property:sys.usb.config=ptp
    write /sys/class/spi_master/spi0/spi0.0/usb_switch 0

on property:sys.usb.config=ptp,adb
    write /sys/class/spi_master/spi0/spi0.0/usb_switch 0
