import init.nv_dev_board.usb.rc
import init.modem_${ro.boot.modem}.rc
import init.quickboot.rc

on early-init
    # pisces: the aged battery cannot carry the full boot current; keep all
    # four cores but cap the frequency and dim the panel during boot.
    write /sys/devices/system/cpu/cpu1/online 1
    write /sys/devices/system/cpu/cpu2/online 1
    write /sys/devices/system/cpu/cpu3/online 1
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 510000
    # pisces: several HALs are still missing and their 5s service waits add up
    # to >60s during system_server start; scale the framework timeouts.
    setprop ro.hw_timeout_multiplier 10
    # the binderized mapper service breaks Gralloc2 (must be passthrough)
    stop vendor.gralloc-2-0
    # pisces: 3.4 kernel uses the legacy android_usb gadget; adbd needs
    # functionfs mounted explicitly (the configfs path A9 defaults to does not
    # exist here).
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    setprop sys.usb.ffs.aio_compat 1
    start adbd
    # pisces: vold is not functional yet; trigger the framework/bootanim path
    # manually once /data is mounted.
    write /sys/block/mmcblk0/queue/scheduler noop
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpufreq/interactive/boost 1
    mount debugfs debugfs /sys/kernel/debug

on init
    mkdir /mnt/shell/emulated 0700 shell shell
    mkdir /storage/emulated 0555 root root
    # mkdir /mnt/media_rw/sdcard1 0700 media_rw media_rw
    # mkdir /storage/sdcard1 0700 root root

    export EXTERNAL_STORAGE /storage/emulated/legacy
    # pisces: no vold yet; zygote aborts if it tries to mount tmpfs there
    # export EMULATED_STORAGE_TARGET /storage/emulated
    export SECONDARY_STORAGE /storage/usbdisk

    # create directory for mounting usb drives
    mkdir /mnt/media_rw/usbdisk 0700 media_rw media_rw
    mkdir /storage/usbdisk 0700 root root
    symlink /storage/usbdisk /usbdisk
    symlink /storage/usbdisk /mnt/usbdisk

    # mkdir /storage_int 0775 media_rw media_rw
    mkdir /persist 0771 system system

    # Immersion
    export VIBE_PIPE_PATH /dev/pipes
    mkdir /dev/pipes 0771 system system
    mkdir /tmp 1777 system system
    mount tmpfs tmpfs /tmp mode=1777,gid=1000
on fs
    setprop ro.crypto.tmpfs_options size=128m,mode=0771,uid=1000,gid=1000
    setprop ro.crypto.umount_sd false
    setprop ro.crypto.fuse_sdcard true
    mount_all /fstab.pisces

    chown system system /persist
    chmod 0771 /persist

    mkdir /data/media 0770 media_rw media_rw
    chown media_rw media_rw /data/media
    chmod 0770 /data/media
    exec /system/bin/sh /system/bin/mount_ext4.sh /dev/block/platform/sdhci-tegra.3/by-name/storage /data/media

    exec /system/bin/sh /system/bin/upgrade_layout.sh

    mkdir /mnt/modem/data 0770 root radio
    mkdir /mnt/modem/data/factory 0770 root radio
    exec /system/bin/conn_init -o

    chown system system /persist/serialno
    chmod 0400 /persist/serialno

# pisces: the ES325 voice processor sits between the I2S and the CS42L73 and
# must run its firmware before the codec's DAPM path can power up - without it
# every es325 i2c write NAKs (-121), the codec stays Off and there is no sound.
# The audience_fw service (see below) already loads it via vpcmd; do not add a
# second loader, the two race on the ES325 and both fail.

    # pisces: vold does not run yet; userdirs.sh creates the DE/CE dirs.
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/firmware 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    mkdir /data/nvcam 0700 media camera
    chown dhcp dhcp /data/misc/dhcp

    mkdir /data/misc/wminput 0776 system system

    mkdir /data/media 0770 media_rw media_rw
    chmod 0770 /data/media
    chown media_rw media_rw /data/media

    # Set indication (checked by vold) that we have finished this action
    setprop vold.post_fs_data_done 1

    # Create GPS folders and set its permissions
    mkdir /data/gps
    chown gps system /data/gps/
    chmod 0770 /data/gps/

    chmod 0600 /dev/bcm2079x
    chown nfc nfc /dev/bcm2079x
    mkdir /data/nfc
    mkdir /data/nfc/param
    chmod 0700 /data/nfc
    chmod 0700 /data/nfc/param
    chown nfc nfc /data/nfc
    chown nfc nfc /data/nfc/param

# Set up HDCP
    import init.hdcp.rc

    rm /dev/sysmatdrv

on early-boot
    # pisces: run these in the background; the audience firmware loader can
    # block forever on the ES325 UART, which hangs init and resets the device.
    start audience_fw
    start atmel_fw

on init
    # pisces: the vendor HCD download in libbt hangs the BCM43341 (it stops
    # answering HCI at any baud until BT_REG_ON is power cycled), and the chip
    # speaks HCI fine on its ROM firmware.  hardware.c honours this property.
    setprop persist.pisces.bt.skip_fw 1



# pisces: this kernel only provides the legacy android_usb gadget, while AOSP's
# init.usb.rc ships configurations for accessory/audio/adb only and the
# init.usb.configfs.rc ones cannot work without /config/usb_gadget.  These rules
# cover every composition the framework asks for through the IUsbGadget HAL.
# rndis is deliberately NOT listed here: the gadget needs a pause between
# "enable 0" and the new composition, init runs the writes back to back and the
# netdev never appeared, so the IUsbGadget HAL handles rndis itself.
#
# adb never runs over the legacy f_adb function on this kernel: f_adb waits for
# /dev/android_adb and keeps the whole gadget disabled until userspace opens it
# (and its descriptor string is "adb"), while Android 9's adbd only knows
# FunctionFS (/dev/usb-ffs/adb).  Every composition that asks for adb therefore
# binds the ffs function and starts adbd, which is what makes the ffs interface
# appear.  sys.usb.state still carries the name the framework requested, since
# that is what it polls, and the IUsbGadget HAL maps ffs back to ADB.
on property:sys.usb.config=adb
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/functions ffs
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4ee7
    write /sys/class/android_usb/android0/bDeviceClass 0
    write /sys/class/android_usb/android0/enable 1
    start adbd
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/functions mtp
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4ee1
    write /sys/class/android_usb/android0/bDeviceClass 0
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp,adb
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/functions mtp,ffs
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4ee2
    write /sys/class/android_usb/android0/bDeviceClass 0
    write /sys/class/android_usb/android0/enable 1
    start adbd
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=ptp
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/functions ptp
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4ee5
    write /sys/class/android_usb/android0/bDeviceClass 0
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=ptp,adb
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/functions ptp,ffs
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4ee6
    write /sys/class/android_usb/android0/bDeviceClass 0
    write /sys/class/android_usb/android0/enable 1
    start adbd
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=none
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/bDeviceClass 0
    stop adbd
    setprop sys.usb.state ${sys.usb.config}

on boot
    # pisces: /storage/emulated here is the raw UDA mount, owned by root, so
    # com.android.bluetooth cannot create its receive directory and OBEX aborts
    # with "can't create base directory /storage/emulated/0/bluetooth".
    # There is no sdcardfs/FUSE daemon here: /storage/emulated is a plain
    # directory owned by media_rw 0770 and /storage/emulated/0 is a bind of
    # /data/media/0 owned by root 0755, so apps (e.g. com.android.bluetooth,
    # which only has the read-only sdcard_r group) cannot even traverse it and
    # OBEX aborts with "can't create base directory".  Widen both until the
    # proper per-app view exists.
    chmod 0771 /storage/emulated
    chmod 0777 /data/media/0
    mkdir /storage/emulated/0/bluetooth 0777 media_rw media_rw
    chmod 0777 /storage/emulated/0/bluetooth
    # pisces: something recreates /data/media/0 with root:root 0755 after this
    # point (MtpServer then fails every SendObject with EACCES on the storage
    # root), so record the mode and re-apply it once the framework is up.
    exec /system/bin/sh -c "echo boot /data/media/0=$(stat -c '%a %U:%G' /data/media/0) >> /cache/storage-mode.txt"
    exec /system/bin/sh -c "echo boot /storage/emulated/0=$(stat -c '%a %U:%G' /storage/emulated/0) >> /cache/storage-mode.txt"

    # pisces: cap all cores and dim the panel during boot
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_max_freq 510000
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_max_freq 510000
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_max_freq 510000
    write /sys/class/backlight/lm3533-backlight0/brightness 20
    write /sys/class/backlight/lm3533-backlight1/brightness 20
#Add from init.rc
    # atomic allocations can get upto 5/8th of this size
    write /proc/sys/vm/min_free_kbytes 16384

    chown system system /sys/class/leds/flashlight/brightness
    # 0666 required by Torch.apk
    chmod 0666 /sys/class/leds/flashlight/brightness

    chown system system /sys/class/timed_output/vibrator/pattern

    #----AKM8963 sysfs entry----
    chown system system /sys/class/compass/akm8963/enable_mag
    chown system system /sys/class/compass/akm8963/delay_mag
#Add end

# bluetooth
    exec /system/bin/conn_init -p
    # change back to bluetooth from system
    chown bluetooth net_bt_stack /data/misc/bluetooth

    # UART device
    chmod 0660 /dev/ttyHS2
    chown bluetooth net_bt_stack /dev/ttyHS2

    # power up/down interface
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/type
    write /sys/class/rfkill/rfkill0/state 0
    chown bluetooth net_bt_stack /sys/class/rfkill/rfkill0/state
    chown bluetooth net_bt_stack /sys/class/rfkill/rfkill0/type

    # bluetooth MAC address programming
    chown bluetooth net_bt_stack ro.bt.bdaddr_path
    chown bluetooth net_bt_stack /system/etc/bluetooth
    chown bluetooth net_bt_stack /data/misc/bluetooth
    setprop ro.bt.bdaddr_path "/data/misc/bluetooth/bdaddr"

# audio
    chmod 0664 /sys/power/suspend/mode
    chown system audio /sys/power/suspend/mode

# EGL
    setprop persist.tegra.default_layout tiled

# NFC
   setprop ro.nfc.port "I2C"
    chmod 0600 /dev/bcm2079x
    chown nfc nfc /dev/bcm2079x
    mkdir /data/nfc
    mkdir /data/nfc/param
    chmod 0700 /data/nfc
    chmod 0700 /data/nfc/param
    chown nfc nfc /data/nfc
    chown nfc nfc /data/nfc/param

# backlight
    chown system system /sys/class/backlight/lm3533-backlight0/brightness
    chown system system /sys/class/backlight/lm3533-backlight1/brightness

# led
    chown system system /sys/class/leds/red/update

# vibrator
    chown system system /sys/class/input/event2/device/device/vibrator_enable

# permissions for haptic device
    chmod 0666 /dev/drv2605

# didim
    chown system system /sys/class/graphics/fb0/device/smartdimmer/enable
    chown system system /sys/class/graphics/fb0/device/smartdimmer/aggressiveness
    chown system system /sys/class/graphics/fb0/device/smartdimmer/sd_window
    chown system system /sys/class/graphics/fb0/device/smartdimmer/sd_window_enable

# CMU
    chown system system /sys/class/graphics/fb0/device/cmu_enable
    chown system system /sys/class/graphics/fb1/device/cmu_enable

# power
    chown system system /sys/kernel/tegra_cap/core_cap_level
    chown system system /sys/kernel/tegra_cap/core_cap_state
    chown system system /sys/module/cpu_tegra/parameters/cpu_user_cap

# Sensor
    # new nodes from linux kernel v3.4
    chown system system /sys/bus/iio/devices/iio:device0/als_ir_mode
    chown system system /sys/bus/iio/devices/iio:device0/proximity_enable

    chown system system /sys/class/invensense/mpu/accl_bias
    chown system system /sys/class/invensense/mpu/accl_enable
    chown system system /sys/class/invensense/mpu/accl_fifo_enable
    chown system system /sys/class/invensense/mpu/accl_fs
    chown system system /sys/class/invensense/mpu/accl_matrix
    chown system system /sys/class/invensense/mpu/clock_source
    chown system system /sys/class/invensense/mpu/compass_enable
    chown system system /sys/class/invensense/mpu/compass_matrix
    chown system system /sys/class/invensense/mpu/compass_scale
    chown system system /sys/class/invensense/mpu/dev
    chown system system /sys/class/invensense/mpu/dmp_firmware
    chown system system /sys/class/invensense/mpu/enable
    chown system system /sys/class/invensense/mpu/fifo_rate
    chown system system /sys/class/invensense/mpu/firmware_loaded
    chown system system /sys/class/invensense/mpu/flick_axis
    chown system system /sys/class/invensense/mpu/flick_counter
    chown system system /sys/class/invensense/mpu/flick_int_on
    chown system system /sys/class/invensense/mpu/flick_lower
    chown system system /sys/class/invensense/mpu/flick_message_on
    chown system system /sys/class/invensense/mpu/flick_upper
    chown system system /sys/class/invensense/mpu/gyro_enable
    chown system system /sys/class/invensense/mpu/gyro_fifo_enable
    chown system system /sys/class/invensense/mpu/gyro_fs
    chown system system /sys/class/invensense/mpu/gyro_matrix
    chown system system /sys/class/invensense/mpu/key
    chown system system /sys/class/invensense/mpu/lpa_freq
    chown system system /sys/class/invensense/mpu/lpa_mode
    chown system system /sys/class/invensense/mpu/pedometer_steps
    chown system system /sys/class/invensense/mpu/pedometer_time
    chown system system /sys/class/invensense/mpu/power
    chown system system /sys/class/invensense/mpu/power_state
    chown system system /sys/class/invensense/mpu/raw_accl
    chown system system /sys/class/invensense/mpu/raw_gyro
    chown system system /sys/class/invensense/mpu/reg_dump
    chown system system /sys/class/invensense/mpu/self_test
    chown system system /sys/class/invensense/mpu/temp_offset
    chown system system /sys/class/invensense/mpu/temp_scale
    chown system system /sys/class/invensense/mpu/temperature
    chown system system /sys/class/invensense/mpu/uevent

# Touch
    chown input input /sys/class/input/input0/enabled
    chown system system /sys/bus/i2c/devices/1-004a/golden_ref
    chown system system /sys/bus/i2c/devices/1-0048/auto_tune

# Power management settings
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/no_lp 0
    write /sys/module/tegra11_emc/parameters/emc_enable 0
    #write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 1000000

    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor conservative
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor conservative
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor conservative
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor conservative

    write /sys/devices/system/cpu/cpufreq/conservative/up_threshold 95
    write /sys/devices/system/cpu/cpufreq/conservative/down_threshold 50
    write /sys/devices/system/cpu/cpufreq/conservative/freq_step 3

    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor interactive

    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/down_delay 500
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/enable 1
    write /sys/devices/system/cpu/cpuquiet/current_governor runnable
    write /sys/module/cpuidle_t11x/parameters/cpu_power_gating_in_idle 31
    write /sys/module/cpuidle_t11x/parameters/slow_cluster_power_gating_noncpu 1
    write /sys/module/cpuidle/parameters/power_down_in_idle 1
    chown system system /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load
    chown system system /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq
    chown system system /sys/devices/system/cpu/cpufreq/interactive/boostpulse

    chown system system /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/no_lp
    chown system system /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/emc_max
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chown system system /sys/devices/system/cpu/cpuquiet/runnable_threads/nr_cpu_limit
    chown system system /sys/devices/tegradc.0/enable
    chown system system /sys/devices/tegradc.1/enable

    chown system system /sys/kernel/tegra_cap/cbus_cap_level
    chown system system /sys/kernel/tegra_cap/cbus_cap_state
    chown system system /sys/devices/platform/host1x/gr3d/enable_3d_scaling
    chown system system /sys/devices/platform/host1x/gr3d/devfreq/gr3d/max_freq
    chown system system /sys/devices/platform/pwm-fan/pwm_cap

# thermal point path used by power HAL
    chown system system /sys/devices/virtual/thermal/thermal_zone5/pid_thermal_gov/max_err_temp
    write /sys/devices/virtual/thermal/thermal_zone5/pid_thermal_gov/max_err_temp 5000
    chown system system /sys/devices/virtual/thermal/thermal_zone5/pid_thermal_gov/power_mode

# Paramters used by power HAL
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chown system system /sys/devices/tegradc.0/enable
    chown system system /sys/devices/tegradc.1/enable
    chown system system /sys/devices/platform/host1x/nvavp/boost_sclk
    chown system system /sys/class/input/input1/enabled
    chown system system /sys/class/input/input2/enabled
    chown system system /sys/class/input/input3/enabled
    chown system system /sys/class/input/input4/enabled
    chown system system /sys/class/input/input5/enabled
    chown system system /sys/class/input/input6/enabled
    chown system system /sys/class/power_supply/max170xx_battery/current_avg
    # pisces: the A9 wifi HAL rewrites the firmware path to select the STA/AP
    # image; the node is root-only by default, so the write fails and chip
    # configuration aborts with ERROR_UNKNOWN.
    # pisces: the tegra camera HAL acquires /sys/power/wake_lock on open and
    # fails the whole open ("AcquireWakeLock-- (error: could not acquire camera
    # wake lock)") because the node is radio:wakelock 0660.
    chmod 0666 /sys/power/wake_lock
    chmod 0666 /sys/power/wake_unlock

    chown wifi wifi /sys/module/bcmdhd/parameters/firmware_path
    chmod 0660 /sys/module/bcmdhd/parameters/firmware_path
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq

# set highest performance for boot up
    write /sys/devices/system/cpu/cpufreq/interactive/target_loads "55 228000:65 1530000:75"
    write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay 40000

    write /sys/module/cpu_tegra/parameters/cpu_user_cap 0
    write /sys/class/graphics/fb0/device/smartdimmer/aggressiveness 29
    write /sys/class/graphics/fb0/device/smartdimmer/enable 1
    write /sys/class/thermal/thermal_zone0/trip_point_0_temp 90000
    write /sys/class/thermal/thermal_zone1/trip_point_0_temp 90000
    write /sys/class/thermal/thermal_zone5/trip_point_0_temp 45000
    write /sys/class/thermal/thermal_zone5/pid_thermal_gov/max_err_temp 10000
    write /sys/class/thermal/thermal_zone5/pid_thermal_gov/power_mode 0
    write /sys/devices/system/cpu/cpuquiet/runnable_threads/nr_cpu_limit 4
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/emc_max 744000000
    write /sys/devices/platform/host1x/gr3d/devfreq/gr3d/max_freq 672000000
    write /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq 1810500
    write /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load 65

# pisces: the cpuquiet "runnable" governor cannot see GPU/sync bound load, so
# it parks the system on CPU0 and never brings the other cores back - one
# 1.02 GHz A15 cannot drive a 1080p client-composited UI.  pisces_cpu.sh takes
# hotplug over and keeps all four cores online at a battery-safe frequency
# (it polls until cpuquiet is enabled, so it is safe to start this early).
    start pisces_cpu

# Default Read Ahead value for sdcards
    write /sys/block/mmcblk0/queue/read_ahead_kb 2048

# Wiimote connect status
    write /data/misc/wminput/connected 0
    chmod 0666 /data/misc/wminput/connected

# GPS init
    write /sys/class/gpio/export 49
    write /sys/class/gpio/gpio49/value 0
    write /sys/class/gpio/gpio49/direction out
    chown root system /sys/class/gpio/gpio49/value
    chmod 0664 /sys/class/gpio/gpio49/value

# EDP attributes
    write /sys/power/edp/battery/backlight0/notify 1
    write /sys/power/edp/battery/backlight1/notify 1
    write /sys/power/edp/battery/core/notify 1
    write /sys/power/edp/battery/depletion/notify 1
    write /sys/power/edp/battery/imx132/notify 1
    write /sys/power/edp/battery/imx135/notify 1
    write /sys/power/edp/battery/max77665f/notify 1

# MAX77665 MUIC

    write /sys/bus/i2c/devices/4-0066/max77665-muic/power/wakeup disabled

# set hwui properties depending on the screen resolution and the memory size
service set_hwui_params /system/bin/set_hwui_params.sh
    class main
    user root
    group root
    oneshot

# CPU Boost: boost CPU on input events
service input-cfboost /system/bin/input_cfboost_init.sh
    class main
    user root
    group root
    disabled

on property:ro.debuggable=1
    # EMC debug interface
    chmod 666 /sys/kernel/debug/tegra_emc/eack_state

on property:ro.debuggable=1
    # Invensense interface
    chmod 0666 /sys/class/invensense/mpu/accl_bias
    chmod 0666 /sys/class/invensense/mpu/accl_enable
    chmod 0666 /sys/class/invensense/mpu/accl_fifo_enable
    chmod 0666 /sys/class/invensense/mpu/accl_fs
    chmod 0666 /sys/class/invensense/mpu/accl_matrix
    chmod 0666 /sys/class/invensense/mpu/clock_source
    chmod 0666 /sys/class/invensense/mpu/compass_enable
    chmod 0666 /sys/class/invensense/mpu/compass_matrix
    chmod 0666 /sys/class/invensense/mpu/compass_scale
    chmod 0666 /sys/class/invensense/mpu/dev
    chmod 0666 /sys/class/invensense/mpu/dmp_firmware
    chmod 0666 /sys/class/invensense/mpu/enable
    chmod 0666 /sys/class/invensense/mpu/fifo_rate
    chmod 0666 /sys/class/invensense/mpu/firmware_loaded
    chmod 0666 /sys/class/invensense/mpu/flick_axis
    chmod 0666 /sys/class/invensense/mpu/flick_counter
    chmod 0666 /sys/class/invensense/mpu/flick_int_on
    chmod 0666 /sys/class/invensense/mpu/flick_lower
    chmod 0666 /sys/class/invensense/mpu/flick_message_on
    chmod 0666 /sys/class/invensense/mpu/flick_upper
    chmod 0666 /sys/class/invensense/mpu/gyro_enable
    chmod 0666 /sys/class/invensense/mpu/gyro_fifo_enable
    chmod 0666 /sys/class/invensense/mpu/gyro_fs
    chmod 0666 /sys/class/invensense/mpu/gyro_matrix
    chmod 0666 /sys/class/invensense/mpu/key
    chmod 0666 /sys/class/invensense/mpu/lpa_freq
    chmod 0666 /sys/class/invensense/mpu/lpa_mode
    chmod 0666 /sys/class/invensense/mpu/pedometer_steps
    chmod 0666 /sys/class/invensense/mpu/pedometer_time
    chmod 0666 /sys/class/invensense/mpu/power
    chmod 0666 /sys/class/invensense/mpu/power_state
    chmod 0666 /sys/class/invensense/mpu/raw_accl
    chmod 0666 /sys/class/invensense/mpu/raw_gyro
    chmod 0666 /sys/class/invensense/mpu/reg_dump
    chmod 0666 /sys/class/invensense/mpu/self_test
    chmod 0666 /sys/class/invensense/mpu/temp_offset
    chmod 0666 /sys/class/invensense/mpu/temp_scale
    chmod 0666 /sys/class/invensense/mpu/temperature
    chmod 0666 /sys/class/invensense/mpu/uevent

    # Invensense debug register interface.
    chmod 0666 /sys/class/invensense/mpu/dbg_reg
    chmod 0666 /sys/class/invensense/mpu/dbg_dat

service dhcpcd_wlan0 /system/bin/dhcpcd -aABKL
    class main
    disabled
    oneshot

service dhcpcd_p2p /system/bin/dhcpcd -aABKL
    class main
    disabled
    oneshot

service dhcpcd_eth0 /system/bin/dhcpcd -ABKL -f/system/etc/dhcpcd/dhcpcd.conf
     class main
     disabled
     oneshot

service dhcpcd_bnep0 /system/bin/dhcpcd -ABKL
    class main
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service iprenew_p2p /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service iprenew_eth0 /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

# pisces: sdcard is started by vold (A9 FUSE mode); the legacy services below
# conflicted with it and failed with "failed to sdcardfs_setup".
# btmacwriter - to create unique BD address
service btmacwriter /system/bin/btmacwriter
    class main
    user bluetooth
    group bluetooth net_bt_admin
    oneshot

# Start GPS daemon
service gps-daemon /system/bin/glgps_nvidiaTegra2android -c /system/etc/gps/gpsconfig.xml
    user gps
    socket gps seqpacket 0660 gps system
    group system inet sdcard_rw sdcard_r
    class late_start

# Mount usb drives as /usbdrive. Generally usb drives are formatted with FAT
# filesystem, so we support FAT as of now.
# on device-added-/sys/block/sda
#   mount auto /dev/block/sda /mnt/media_rw/usbdrive
# 
# on device-removed-/sys/block/sda
#   umount /mnt/media_rw/usbdrive

# Prepare TF service
# import init.tf.rc

# Enable NvCpuD, and set it to never poll config again
on boot
    setprop nvcpud.enabled true
    setprop nvcpud.config_refresh_ms -1

service nvcpud /system/bin/nvcpud
    class main
    user system
    group system
    oneshot

# unified scaling setup
service ussr_setup /system/bin/ussr_setup.sh
    class main
    user root
    group root
    oneshot

# unified scaling process
service ussrd /system/bin/ussrd
    user root
    group root
    class main
    disabled

# unified scaling watchdog process
service usdwatchdog /system/bin/usdwatchdog --wait 30
    user root
    group root
    class main
    disabled

# Second boot and onwards
on property:persist.wlan.ti.calibrated=1
    insmod /system/lib/modules/compat/wl12xx_sdio.ko

# Very first boot. This case should be below the above case in init.rc so that
# the above case, does not get executed on first boot. Very first boot is setting
# persist.wlan.ti.calibrated=1 which triggers the above case.

service dns_masq /system/bin/dnsmasq --no-daemon --no-resolv --no-poll --dhcp-option-force=43,ANDROID_METERED --dhcp-range=192.168.42.2,192.168.42.254,1h &
    class main
    user dhcp
    group dhcp wifi system
    disabled
    oneshot

# pisces: rild needs the pre-M libcutils socket_loopback_client() (the vendor
# libril-xiaomi-sprd.so references it) and 3.4 cannot use the stock rc's
# "capabilities" line, so the service is defined here instead.  init parses
# this file before /vendor/etc/init, so this definition wins.
service ril-daemon /vendor/bin/hw/rild
    class main
    user radio
    group radio cache inet misc audio log readproc wakelock
    socket rild stream 660 root radio
    socket rild-debug stream 660 radio system
    setenv LD_PRELOAD /system/lib/libpisces_rilshim.so

# pisces: the stock rc starts this HAL with "group wifi gps".  With
# CONFIG_ANDROID_PARANOID_NETWORK the socket(AF_INET) it needs is denied
# without the inet group, and this kernel (3.4) has no ambient capabilities so
# the rc "capabilities" line cannot be used at all.  This definition is parsed
# before /vendor/etc/init, so it wins over the stock one.
#
# It has to run as root: starting SoftAP makes the HAL reconfigure the chip
# from mode 0 (STA) to mode 1 (AP) and bring wlan0 up itself, which needs
# CAP_NET_ADMIN.  As plain "wifi" that failed with
#   "Could not set interface flags for wlan0 (Permission denied)"
#   "Failed to start legacy HAL: UNKNOWN"
#   "executeChipReconfiguration: configureChip error: 9"
# and the hotspot switched itself off ~1 s after it was enabled.
service vendor.wifi_hal_legacy /vendor/bin/hw/android.hardware.wifi@1.0-service
    class hal
    user root
    group root wifi gps inet

# pisces: Android 9 uses the HIDL supplicant (/vendor/bin/hw/wpa_supplicant),
# started lazily by hwservicemanager through these interface declarations; the
# framework never spawns it itself.  The legacy 8.x daemon that used to be
# here talked to the old WifiNative and no longer exists.
service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -Dnl80211 -iwlan0 -c/vendor/etc/wifi/wpa_supplicant.conf -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

# pisces: the 2013 tegra camera HAL needs two shims the A9 loader no longer
# provides: the Android 4.x SensorManager entry points, and acceptance of the
# text relocations in libFaceProc.so (the shim drops the process target SDK to
# 22).  LD_PRELOAD is the only way to get them into the vendor module's linker
# namespace.  This definition is parsed before /vendor/etc/init/..., so init
# ignores the stock one.
# pisces camera provider.  Findings from the session-9 investigation (the
# stock kernel source has been cloned to /data/twrp/kernel/stock-src):
#
#  * The stock 3.4.35 kernel is configured exactly like ours
#    (TEGRA_AVP=n, TEGRA_MEDIASERVER=n, TEGRA_NVAVP=y, SOC_CAMERA=n,
#    TEGRA_CAMERA=y) and its tegra_v4l2_camera.c is byte-identical, so the
#    stock ROM never had /dev/video* either - the missing V4L2 nodes are not
#    the blocker.
#  * The stock camera lived inside mediaserver, which ran as "user media"
#    (uid 1013).  Running our provider the same way (user media, groups
#    audio camera system inet drmrpc mediadrm radio) does get much further:
#    the sensor powers up, NvCameraHal::ApplyChangedSettings() runs and the
#    open takes ~1.3 s - and then setupHalInLock() blocks in pthread_join()
#    waiting for a thread that sits in tegra_sema_wait forever (13 threads).
#    The same happens with uid cameraserver plus the media/system groups, so
#    it is not a permissions problem: the 2013 NvMM userspace deadlocks in
#    its TRPC/semaphore IPC under Android 9's bionic.
#  * Keeping the stock group list makes the open fail cleanly with
#    NvError 0x3 after 5 s instead of wedging cameraserver, so every app that
#    touches the camera still gets an error rather than a hang.
service vendor.camera-provider-2-4 /vendor/bin/hw/android.hardware.camera.provider@2.4-service
    class hal
    user media
    group audio camera system inet drmrpc mediadrm radio
    ioprio rt 4
    setenv LD_PRELOAD /system/lib/libpisces_camshim.so
    writepid /dev/cpuset/camera-daemon/tasks /dev/stune/top-app/tasks

on charger
    write /sys/class/backlight/lm3533-backlight0/brightness 100
    write /sys/class/backlight/lm3533-backlight1/brightness 100
    # used by adb
    mount ext4 /dev/block/platform/sdhci-tegra.3/by-name/system /system

service charger /sbin/healthd -c
    class charger
    critical
    seclabel u:r:healthd:s0

# pisces: bluedroid_pm exposes the BCM43341 power switch as rfkill0 and it
# comes up blocked, so the controller never answers on the UART.
on boot
    write /sys/class/rfkill/rfkill0/state 1

# pisces: the A9 Bluetooth HAL aborts with "Open: No Bluetooth Address!" when
# /data/misc/bluetooth/bdaddr is missing; the factory address ships next to the
# BT config files.
on post-fs-data
    mkdir /data/misc/bluetooth 0770 bluetooth bluetooth
    copy /system/etc/bluetooth/bdaddr /data/misc/bluetooth/bdaddr
    chown bluetooth bluetooth /data/misc/bluetooth/bdaddr
    chmod 0660 /data/misc/bluetooth/bdaddr

on property:init.svc.charger=running
    write /sys/class/input/input1/enabled 0
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor userspace
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_setspeed 51000
    write /sys/kernel/cluster/active lp
    write /sys/kernel/cluster/immediate 1
    write /sys/kernel/cluster/force 1

    write /sys/devices/system/cpu/cpuquiet/current_governor runnable

    write /sys/devices/system/cpu/cpufreq/interactive/target_loads "75 228000:85 816000:90 1530000:95"
    write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay "40000 1530000:50000"
    write /sys/module/cpu_tegra/parameters/cpu_user_cap 1100000
    write /sys/class/graphics/fb0/device/smartdimmer/aggressiveness 29
    write /sys/class/graphics/fb0/device/smartdimmer/enable 1
    write /sys/class/thermal/thermal_zone0/trip_point_0_temp 75000
    write /sys/class/thermal/thermal_zone0/trip_point_0_temp 75000
    write /sys/class/thermal/thermal_zone5/trip_point_0_temp 40000
    write /sys/class/thermal/thermal_zone5/pid_thermal_gov/max_err_temp 5000
    write /sys/class/thermal/thermal_zone5/pid_thermal_gov/power_mode 2
    write /sys/devices/system/cpu/cpuquiet/runnable_threads/nr_cpu_limit 1
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/emc_max 528000000
    write /sys/devices/platform/host1x/gr3d/devfreq/gr3d/max_freq 468000000
    write /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq 612000
    write /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load 99

# add from init.rc
service akmd /system/bin/akmd8963
    class core
    user system
    group system misc input
# end of add

service nv_power_high /system/bin/power_mode.sh 0
    user system
    group system
    oneshot
    disabled

service nv_power_middle /system/bin/power_mode.sh 1
    user system
    group system
    oneshot
    disabled

service nv_power_low /system/bin/power_mode.sh 2
    user system
    group system
    oneshot
    disabled

# pisces: the ImmVibe vibrator HAL loads libImmVibeJ.so/libpparam.so, which
# carry text relocations that bionic only loads for API-22 targets.
service vendor.vibrator-1-0 /vendor/bin/hw/android.hardware.vibrator@1.0-service
    class hal
    user system
    group system
    setenv LD_PRELOAD /system/lib/libpisces_camshim.so

service immvibed /system/bin/immvibed
    setenv TMPDIR /tmp
    # pisces: libpparam.so (the ImmVibe actuator parameter blob) carries text
    # relocations, which bionic refuses to load for a process targeting API 23
    # or newer; the shim drops the target SDK to 22.  Without it immvibed
    # cannot initialise and every vibration is dropped with status -4.
    setenv LD_PRELOAD /system/lib/libpisces_camshim.so
    class late_start
    user system
    group system
    oneshot

service pisces_cpu /system/bin/sh /pisces_cpu.sh
    class main
    user root
    group root system
    oneshot
    disabled

on property:sys.boot_completed=1
    # pisces: four cores are kept online by pisces_cpu.sh; re-assert the
    # battery-safe frequency cap for the case where a core was re-onlined
    # later (a new cpufreq policy starts at 1.8 GHz, which resets the phone).
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 1224000
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_max_freq 1224000
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_max_freq 1224000
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_max_freq 1224000

    write /sys/block/mmcblk0/queue/scheduler cfq
    write /sys/devices/system/cpu/cpufreq/interactive/boost 0
    exec /system/bin/pm grant net.tonyliu.mi3setting android.permission.ACCESS_FINE_LOCATION
    exec /system/bin/pm grant net.tonyliu.mi3setting android.permission.ACCESS_LOCATION_EXTRA_COMMANDS

on property:sys.perf.profile=high
    start nv_power_high
    write /sys/devices/system/cpu/cpufreq/interactive/target_loads "55 228000:65 1530000:75"
    write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay 20000

on property:sys.perf.profile=middle
    start nv_power_middle
    write /sys/devices/system/cpu/cpufreq/interactive/target_loads "75 228000:85 816000:90 1530000:95"
    write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay "20000 1530000:50000"

on property:sys.perf.profile=low
    start nv_power_low
    write /sys/devices/system/cpu/cpufreq/interactive/target_loads "75 228000:85 816000:90 1530000:95"
    write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay "20000 1530000:50000"

on property:persist.zram.size=128
    swapon_all fstab.zram_128

on property:persist.zram.size=256
    swapon_all fstab.zram_256

on property:persist.zram.size=512
    swapon_all fstab.zram_512

on property:persist.sys.display_prefer=0
    write /sys/devices/platform/host1x/tegradc.0/graphics/fb0/set_dispparam 2

on property:persist.sys.display_prefer=1
    write /sys/devices/platform/host1x/tegradc.0/graphics/fb0/set_dispparam 1

on property:persist.sys.display_prefer=2
    write /sys/devices/platform/host1x/tegradc.0/graphics/fb0/set_dispparam 2

on property:persist.sys.display_prefer=3
    write /sys/devices/platform/host1x/tegradc.0/graphics/fb0/set_dispparam 3

on property:persist.sys.display_ce=10
    write /sys/devices/platform/host1x/tegradc.0/graphics/fb0/set_dispparam 240

on property:persist.sys.display_ce=11
    write /sys/devices/platform/host1x/tegradc.0/graphics/fb0/set_dispparam 16

on property:persist.force_fast_charge=0
    write /sys/kernel/fast_charge/force_fast_charge 0

on property:persist.force_fast_charge=1
    write /sys/kernel/fast_charge/force_fast_charge 1

# pisces: capture userspace boot logs to /cache so they can be pulled from
# TWRP when adb is not available yet (suggested by community).
service bootlog /system/bin/logcat -b all -D -f /cache/boot_log.txt
    class main
    user root
    group root system
    disabled
    oneshot

on property:init.svc.logd=running
    rm /cache/boot_log.txt
    start bootlog

on property:sys.boot_completed=1
    stop bootlog

# pisces: persist the kernel log ring buffer to /cache as early as logd is up,
# so early boot messages survive even a hard power cut / hang.
service kmsglog /system/bin/logcat -b kernel -f /cache/kmsg.log
    class main
    user root
    group root system
    disabled
    oneshot

on property:init.svc.logd=running
    rm /cache/kmsg.log
    start kmsglog

on property:sys.boot_completed=1
    stop kmsglog

# pisces: vold / the framework recreate /data/media/0 (root:root 0755) after
# "on boot", which is exactly the storage root MtpServer writes into - every
# host->phone transfer then failed with "Failed to create folder ...: Permission
# denied" / SendObjectInfo GENERAL_ERROR.  Re-apply the wide mode once the
# framework has settled; /storage/emulated/0 is the same inode, so one chmod
# covers both names.
on property:sys.boot_completed=1
    chmod 0777 /data/media/0
    chmod 0777 /storage/emulated/0
    exec /system/bin/sh -c "echo boot_completed /data/media/0=$(stat -c '%a %U:%G' /data/media/0) >> /cache/storage-mode.txt"

on post-fs-data
    setprop vold.decrypt trigger_restart_framework

on boot
    setprop service.adb.root 1
    # pisces: install the default composition before the framework starts.
    # ffs needs adbd, so the boot composition is what starts it; the framework
    # replaces the composition later (it reads this property for mAdbEnabled).
    setprop persist.sys.usb.config mtp,adb
    setprop sys.usb.config mtp,adb

service usbdebug /system/bin/sh /system/etc/usbdebug.sh
    class core
    user root
    group root system
    oneshot
    disabled

on post-fs-data
    start usbdebug

service userdirs /system/bin/sh /system/etc/userdirs.sh
    class core
    user root
    group root system
    oneshot
    disabled

on post-fs-data
    exec /system/bin/sh -c "cat /proc/last_kmsg > /cache/last_kmsg.txt 2>/dev/null"
    start userdirs

service audience_fw /system/bin/sh /system/bin/load_audience_fw.sh --log
    class core
    user root
    group root system
    oneshot
    disabled

service atmel_fw /system/bin/sh /system/bin/atmel_fw_update.sh
    class core
    user root
    group root system
    oneshot
    disabled
