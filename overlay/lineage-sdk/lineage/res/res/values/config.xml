<?xml version="1.0" encoding="utf-8"?>
<!--
     LM3533 RGB notification / charging LED (pisces).

     The framework only touches the LEDs when the device declares them here:
     LightsCapabilities.supports() reads this bit field, LineageBatteryLights
     reports "not supported" and BatteryService never drives the charging LED
     with the stock value (8: pulsating only).

     LIGHTS_RGB_NOTIFICATION_LED = 1
     LIGHTS_RGB_BATTERY_LED      = 2
     LIGHTS_PULSATING_LED        = 8
     LIGHTS_BATTERY_LED          = 64
     1 + 2 + 8 + 64 = 75
-->
<resources>
    <integer name="config_deviceLightCapabilities">75</integer>
</resources>
